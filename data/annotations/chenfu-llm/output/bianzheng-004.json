              "herbId": "北五味",
              "roleText": "固涩",
              "mechanism": "收敛散气",
              "sourceSentence": "人喘则气散，非五味子何以能收敛乎"
            },
            {
              "herbId": "熟地黄",
              "roleText": "益肾",
              "mechanism": "益肾中之水以制火",
              "sourceSentence": "用熟地以益肾中之水也，肾水大足，自不去泄肺金之气"
            },
            {
              "herbId": "山茱萸",
              "roleText": "益肾",
              "mechanism": "赞襄熟地使水火既济",
              "sourceSentence": "又益之以山茱萸，以赞襄熟地之不逮，自能水火既济，而气易还元也"
            }
          ]
        },
