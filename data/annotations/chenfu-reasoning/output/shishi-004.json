    {
      "clauseId": "shishi-0091",
      "contentHash": "58570bb54110e48a",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "如人病伤筋力，将肝叶倒转，视各物倒置",
          "disputes": [],
          "organs": ["肝"],
          "relations": [],
          "treatmentPrinciple": "必须动其怒气，使肝叶开张，而后击之",
          "methodCategory": "倒治法",
          "formulaIds": []
        },
        {
          "caseIndex": 1,
          "symptomText": "更有痰结在胃中，不能吐出，狂言如见鬼状，时发时止，气塞胸膛",
          "disputes": [],
          "organs": ["胃"],
          "relations": [],
          "methodCategory": "倒治法",
          "formulaIds": [],
          "formulaText": "以牛肉五斤，水二斗，煎汤饮之"
        }
      ]
    },
    {
      "clauseId": "shishi-0092",
      "contentHash": "dfb8bbc092bdac08",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "如人堕水而死",
          "disputes": [],
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "令一人将死人双足反背在肩上，行二里许",
          "methodCategory": "倒治法",
          "formulaIds": [],
          "formulaText": "急以人参三钱，茯苓一两，白术五钱，薏仁五钱，车前五钱。肉桂一钱，煎汤半盏灌之"
        }
      ]
    },
    {
      "clauseId": "shishi-0093",
      "contentHash": "4293e86704929982",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "毒结成于肺叶之下，吐痰即痛欲死，手按痛处，亦痛欲死",
          "disputes": [],
          "pathogenesis": "必其人不守禁忌，犯色而变者也",
          "organs": ["肺"],
          "relations": [],
          "treatmentPrinciple": "此等肺痈，必须开刀",
          "methodCategory": "缚治法",
          "formulaIds": [],
          "formulaText": "方用金银花一两，元参五钱，人参三钱，甘草三钱"
        }
      ]
    },
    {
      "clauseId": "shishi-0094",
      "contentHash": "1f34b6d914d016bf",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "凡人有伸欠，而两手不能下者",
          "disputes": [],
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "将人抱住，缚在柱上，又把木棒打去",
          "methodCategory": "缚治法",
          "formulaIds": [],
          "formulaText": "下后用当归一两，川芎五钱，红花五分，生地五钱，桃仁五个，甘草一钱，大黄一钱，丹皮二钱，水煎服"
        }
      ]
    },
    {
      "clauseId": "shishi-0095",
      "contentHash": "fab15274de45b89d",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "肥人多痰",
          "disputes": [],
          "pathogenesis": "乃气虚也。虚则气不能营运，故痰生之",
          "organs": ["脾", "胃", "命门", "心包", "肾"],
          "relations": [{ "from": "命门", "to": "脾", "kind": "生" }],
          "treatmentPrinciple": "必须补其气，而后带消其痰为得耳",
          "methodCategory": "肥治法",
          "formulaIds": [],
          "formulaText": "方用人参三两，白术五两，茯苓二两，薏仁五两，芡实五两，熟地八两，山茱萸四两，北五味一两，杜仲三两，肉桂二两，砂仁五钱，益智仁一两，白芥子三两，桔红一两，各为末，蜜为丸"
        },
        {
          "caseIndex": 1,
          "symptomText": "若有人不肯服丸药",
          "disputes": [],
          "organs": ["肾", "脾", "胃"],
          "relations": [],
          "treatmentPrinciple": "此方治气虚而兼补肾水、肾火者也",
          "methodCategory": "肥治法",
          "formulaIds": ["shishi-formula-当用煎"],
          "formulaText": "用人参三钱，白术五钱，茯苓三钱，熟地一两，山茱萸四钱，肉桂一钱，砂仁一钱，益智仁一钱，半夏一钱，陈皮五分，神曲一钱，水煎服"
        }
      ]
    },
