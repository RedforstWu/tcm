      "cases": [
        {
          "caseIndex": 0,
          "disputes": [
            { "kind": "mistreatment", "claim": "此症若降火", "rebuttal": "则火由脾而入于大肠，必变为便血之症" }
          ],
          "organs": ["脾", "大肠"],
          "relations": [],
          "treatmentPrinciple": "法宜清火止吐",
