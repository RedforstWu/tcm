          "formulaText": "方用利肝分水饮"
        },
        {
          "caseIndex": 1,
          "symptomText": "脾疸之症，身黄如秋葵之色，汗衣服，皆成黄色，兼之涕唾亦黄，不欲闻人言，小便不利",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为黄汗之病也",
              "rebuttal": "谁知是脾阴之黄乎"
            },
            {
              "kind": "misdiagnosis",
              "claim": "热宜非脾之所恶，何故成黄",
              "rebuttal": "不知脾虽不恶热而畏湿"
            }
          ],
          "pathogenesis": "脾中阳气尽行消亡，无阳则阴不能化，土成纯阴之土",
          "organs": [
            "脾",
            "膀胱",
            "心",
            "胆",
            "命门"
          ],
          "relations": [],
          "treatmentPrinciple": "则治法宜大健其脾，而温其命门之气，佐之以利水之剂",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0217",
      "contentHash": "18a8de93d3e66e44",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0217-1"
          ],
          "formulaText": "方用补火散邪汤",
          "keySentence": "此方白术、人参以补其脾，茯苓、茵陈以利其水，附子以温其火，真火生而邪火自散，元阳回而阴气自消"
        },
        {
          "caseIndex": 1,
          "symptomText": "肾疸之症，身体面目俱黄，小便不利，不思饮食，不得卧",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为黄胆也",
              "rebuttal": "谁知是肾寒之故乎"
            },
            {
              "kind": "mistreatment",
              "claim": "如肾疸之病，不可治瘅",
              "rebuttal": "一治瘅而黄胆反不能痊"
            }
          ],
          "pathogenesis": "肾火旺而水流，肾火衰而水积",
          "organs": [
            "肾",
            "膀胱",
            "脾"
          ],
          "relations": [],
          "treatmentPrinciple": "必须补其肾中之火，而佐之去湿健脾之药",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0218",
      "contentHash": "37cda1e6bd8fbe5e",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0218-1",
            "bianzheng-formula-bianzheng-0218-2"
          ],
          "formulaText": "方用济水汤",
          "keySentence": "得肉桂以生其命门之火，则肾不寒，而元阳之气自能透化于膀胱"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有心惊胆颤，面目俱黄，小水不利，皮肤瘦削",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为黄胆之症",
              "rebuttal": "谁知是胆怯而湿乘之乎"
            },
            {
              "kind": "misdiagnosis",
              "claim": "水湿入胆，宜投其所喜，何反成黄胆之病",
              "rebuttal": "盖水多则木泛，木之根不实矣"
            }
          ],
          "pathogenesis": "胆怯则水邪愈胜，胆不能防，水邪直入胆中，而胆之汁反越出于胆之外",
          "organs": [
            "胆",
            "脾",
            "膀胱"
          ],
          "relations": [],
          "treatmentPrinciple": "故水泻而土又不可不培也，培其土而木气始能养耳",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0218-3"
          ],
          "keySentence": "此方利湿无非利胆之气，利胆无非健脾之气也"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有小便点滴不能出，小腹臌胀，两足浮肿，一身发黄",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为黄瘅矣",
              "rebuttal": "谁知是膀胱湿热，结而成瘅乎"
            }
          ],
          "pathogenesis": "是膀胱之黄瘅，乃热病而非寒病也",
          "organs": [
            "膀胱",
            "肺",
            "命门"
          ],
          "relations": [],
          "treatmentPrinciple": "解热者，必用凉药以益肺金之气",
          "formulaIds": []
        }
      ]
    },
    {
