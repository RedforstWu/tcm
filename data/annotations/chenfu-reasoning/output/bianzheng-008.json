          "keySentence": "此方名为滋心，实多滋肾之味"
        }
      ]
    },
    {
      "clauseId": "bianzheng-0213",
      "contentHash": "479cae6673a28bed",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "谷瘅之症，胸中易饥，食则难饱，多用饮食则发烦，头眩、小便艰涩，身如黄金之色",
          "disputes": [],
          "pathogenesis": "胃无阴以和阳，则热聚而消谷；脾无阳以和阴，则寒聚而积水",
          "organs": [
            "脾",
            "胃",
            "膀胱"
          ],
          "relations": [],
          "treatmentPrinciple": "治法升胃中之清气，以分利其膀胱",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0213-1"
          ],
          "keySentence": "方中以茯苓为君者，利水而不伤胃气"
        },
        {
          "caseIndex": 1,
          "symptomText": "酒疸之症，心中时时懊，热不能食，尝欲呕吐，胸腹作满，然清言了了",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为酒食作疸也",
              "rebuttal": "然而酒湿之成疸，由于内伤饥饱劳役也"
            },
            {
              "kind": "misdiagnosis",
              "claim": "夫心至懊，其心神之昏乱可知，何又能清言了了耶",
              "rebuttal": "不知酒气熏蒸于一时，则见懊"
            }
          ],
          "pathogenesis": "胆损不能渗酒，酒必留于脾胃之间",
          "organs": [
            "胆",
            "脾",
            "胃",
            "膀胱"
          ],
          "relations": [],
          "treatmentPrinciple": "治法宜解其酒之毒，而兼壮其胆",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0214",
      "contentHash": "0884720ea22101f9",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0214-1"
          ],
          "formulaText": "方用旺胆消酒汤"
        },
        {
          "caseIndex": 1,
          "symptomText": "女劳之疸，其症肾气虚损，四肢酸痛，夜梦惊恐，精神困倦，饮食无味，举动乏力，心腹胀满，脚膝痿缓，房室不举，股内湿痒，水道涩痛，时有余沥，小腹满身尽黄，额上黑",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为黄胆之症",
              "rebuttal": "谁知因女色而成者乎"
            },
            {
              "kind": "mistreatment",
              "claim": "倘用抵当汤水蛭之类，以峻攻其瘀血，或用矾石散硝石之品，以荡涤其微阴",
              "rebuttal": "则促之立亡矣"
            },
            {
              "kind": "drugDoubt",
              "claim": "或疑女劳之疸成于肾之无火，似当补火",
              "rebuttal": "不知疸虽成于无火，今病久阴耗，若补火则恐烁阴"
            }
          ],
          "pathogenesis": "故女劳之疸，仍是湿热而结于精窍之间，非血瘀而闭于骨髓之内也",
          "organs": [
            "肾",
            "膀胱"
          ],
          "relations": [],
          "treatmentPrinciple": "治法宜补肾中之气，而不可有助火之失。宜利膀胱之水，而不可有亡阴之愆",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0214-2"
          ],
          "keySentence": "盖此丹固本以救伤，并不逐邪以泻瘀，肾气日健，而黄色日减矣"
        },
        {
          "caseIndex": 2,
          "symptomText": "肺疸之症，鼻塞不通，头面俱黄，口澹咽干，小水不利",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为黄胆之症",
              "rebuttal": "谁知实由于肺气之虚耶"
            }
          ],
          "pathogenesis": "惟其肺气先虚，而后湿热郁蒸于胸膈之间，致肺燥而失其清肃之令",
          "organs": [
            "肺",
            "膀胱",
            "脾",
            "胃"
          ],
          "relations": [
            {
              "from": "脾",
              "to": "肺",
              "kind": "生"
            },
            {
              "from": "胃",
              "to": "肺",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "治法宜宣通肺气，健其脾胃之土",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0215",
      "contentHash": "2ee370ca5faaff77",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0215-1"
          ],
          "formulaText": "方用扬肺利湿汤",
          "keySentence": "此方开腠理而生津液，则肺金有润燥之功"
        },
        {
          "caseIndex": 1,
          "symptomText": "心疸之症，烦渴引饮，一饮水即停于心之下，时作水声，胸前时多汗出，皮肤尽黄，惟两目独白",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为黄胆也",
              "rebuttal": "谁知是心中虚热以成之乎"
            },
            {
              "kind": "mistreatment",
              "claim": "倘徒治黄而不辨其脏气之生克，妄用龙胆草等药",
              "rebuttal": "必至变为寒黄之症，反难施治矣"
            }
          ],
          "pathogenesis": "盖水乃阴物，阴居阳地，不肯遽入于小肠",
          "organs": [
            "心",
            "小肠",
            "膀胱",
            "肝"
          ],
          "relations": [
            {
              "from": "肝",
              "to": "心",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "宜补肝气以生心，泻水湿以逐热",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0215-2"
          ],
          "keySentence": "此方补肝即所以补心，泻水即以泻热"
        },
        {
          "caseIndex": 2,
          "symptomText": "肝疸之症，两目尽黄，身体四肢亦现黄色，但不如眼黄之甚，气逆手足发冷，汗出不止，然止在腰以上，腰以下无汗",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为黄胆也",
              "rebuttal": "谁知是肝气之郁，湿热团结而不散乎"
            },
            {
              "kind": "misdiagnosis",
              "claim": "夫肝属木，非水不长，何以得湿而反郁乎",
              "rebuttal": "不知肝之所喜者，肾水也，非外来之邪水也"
            }
          ],
          "pathogenesis": "肾水生木而发生，邪水克木而发瘅",
          "organs": [
            "肝",
            "肾",
            "脾",
            "胃",
            "膀胱"
          ],
          "relations": [
            {
              "from": "肾",
              "to": "肝",
              "kind": "生"
            },
            {
              "from": "肝",
              "to": "脾",
              "kind": "移邪"
            }
          ],
          "treatmentPrinciple": "治法开肝气之郁，佐之分湿散邪之剂",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0216",
      "contentHash": "add3ebad38e65e21",
      "cases": [
        {
