          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0211-1"
          ],
          "formulaText": "方用收汗丹",
          "keySentence": "补阴则阴旺自足摄阳，不必止汗而汗自止"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有心头有汗，一身手足无汗者",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为心热之故也",
              "rebuttal": "谁知是思虑过多，心虚而无血以养心乎"
            },
            {
              "kind": "misdiagnosis",
              "claim": "液干宜无汗矣，何心头多出汗耶",
              "rebuttal": "不知此汗非汗也，乃心中之液，内不能存，外走而汗出耳"
            },
            {
              "kind": "misdiagnosis",
              "claim": "或疑心液无多，安得尽化为汗",
              "rebuttal": "不知心为君主之官，心热则五脏七腑之液群来相资"
            }
          ],
          "pathogenesis": "思虑过多，则心火炎烧，逼干其液",
          "organs": [
            "心"
          ],
          "relations": [],
          "treatmentPrinciple": "治法补血以养心，泻火以生液，不必止汗而汗自止矣",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0212",
