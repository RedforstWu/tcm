          "formulaIds": [
            "bianzheng-formula-bianzheng-0221-1",
            "bianzheng-formula-bianzheng-0221-2"
          ],
          "formulaText": "方用填坎汤",
          "keySentence": "此方脾肾兼补，又是分水止泻之药，则湿气自解"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有腹中大痛，手不可按，一时大泻，饮食下喉即出，完谷不化，势如奔马，不可止抑",
          "disputes": [],
          "pathogenesis": "此肝经风木挟邪而大泻也",
          "organs": [
            "肝",
            "脾",
            "胃"
          ],
          "relations": [
            {
              "from": "肝",
              "to": "脾",
              "kind": "克"
            },
            {
              "from": "肝",
              "to": "胃",
              "kind": "克"
            }
          ],
          "treatmentPrinciple": "治法必须急救其脾胃之气，而后因势利导之",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0221-3"
          ],
          "keySentence": "此方用人参以固其脾胃之气，则气不至于骤脱，然最奇在用大黄也"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有口渴饮水，忽然大泻，一日或十余行，或数十行，昼夜之间，泻至数百次，完谷不化，直下无留",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为火泻也",
              "rebuttal": "谁知是肾水不足以制火乎"
            },
            {
              "kind": "mistreatment",
              "claim": "然而徒止其泻，不急救其阴",
              "rebuttal": "则亡阴立尽，何以制火以存其胃气乎"
            }
          ],
          "pathogenesis": "肾水一亏，胃火必旺",
          "organs": [
            "肾",
            "胃",
            "膀胱",
            "大肠"
          ],
          "relations": [
            {
              "from": "胃",
              "to": "肾",
              "kind": "侮"
            }
          ],
          "treatmentPrinciple": "自宜急救其标",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0222",
      "contentHash": "88b56b6b376552d0",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0222-1"
          ],
          "formulaText": "方用生阴止泻汤",
          "keySentence": "此方纯是补肾补胃之药，非止泻之剂也，然而止泻之妙，已存于补阴之中，盖阳火得阴而即止也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有终年饮酒，不知禁忌，逞醉入房，过于泄精，久则脾气大伤，变成水泻，一感风寒，遂大泻不止，如溏如积",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为酒湿损脾也",
