            "bianzheng-formula-bianzheng-0219-1"
          ],
          "formulaText": "方用清肺通水汤",
          "keySentence": "此方虽与扬肺利湿汤大同小异，实有不同也"
        }
      ]
    },
    {
      "clauseId": "bianzheng-0220",
      "contentHash": "420fe72657ed0ca7",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有饥渴思饮食，饮食下腹便觉饱闷。必大泻后快，或早或晚，一昼夜数次以为常，面色黄稿，肢肉减削",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "此非胃气之虚",
              "rebuttal": "乃脾气之困也"
            }
          ],
          "pathogenesis": "能食不能消者，脾气之困，由于命门之寒也",
          "organs": [
            "脾",
            "胃",
            "命门",
            "心包",
            "肾"
          ],
          "relations": [],
          "treatmentPrinciple": "治法不宜治胃，而宜治脾；不宜单治脾，兼宜治肾中之火",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0220-1"
          ],
          "keySentence": "附子、破故纸助命门之神品"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有长年作泻，五更时必痛泻二、三次，重则五、六次，至日间又不作泻",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为脾胃之虚寒",
              "rebuttal": "谁知是肾与命门之虚寒乎"
            },
            {
              "kind": "mistreatment",
              "claim": "用止水之剂",
              "rebuttal": "反不能止"
            }
          ],
          "pathogenesis": "惟其命门火衰，不能蒸腐水谷，脾遂传水湿之气于肾而不返矣",
          "organs": [
            "肾",
            "命门",
            "脾",
            "胃"
          ],
          "relations": [
            {
              "from": "脾",
              "to": "肾",
              "kind": "移邪"
            }
          ],
          "treatmentPrinciple": "必须用补水之味，使亡阴者速生。尤须于补阴之中，兼补其火",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0221",
      "contentHash": "cd26d62ea9b499f4",
      "cases": [
        {
          "caseIndex": 0,
