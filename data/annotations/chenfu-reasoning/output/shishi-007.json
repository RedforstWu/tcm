    {
      "clauseId": "shishi-0187",
      "contentHash": "1e720f4f721a692f",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "夫吐血则必血虚",
          "disputes": [
            { "kind": "drugDoubt", "claim": "用当归一味以补血足矣，何以又佐之黄也", "rebuttal": "盖血乃有形之物，不能速生，必得气旺以生血" }
