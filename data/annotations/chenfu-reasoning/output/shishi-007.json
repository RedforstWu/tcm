{
  "entries": [
    {
      "clauseId": "shishi-0181",
      "contentHash": "143c1496c5747379",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "如人粪从小便出，小便从大便出者",
          "disputes": [],
          "pathogenesis": "此夏天暑热之症",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "止用车前子三两，煎汤三碗，一气服完即愈"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有腹中生蛇者",
          "disputes": [],
          "pathogenesis": "乃毒气化成也",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用雄黄一两，白芷五钱，生甘草二两，各为细末"
        },
        {
          "caseIndex": 2,
          "symptomText": "身必干涸如柴，似有鳞甲者",
          "disputes": [],
          "pathogenesis": "蛇毒也",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "白芷一味为丸"
        }
      ]
    },
    {
      "clauseId": "shishi-0182",
      "contentHash": "41b17d21b58caad2",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "生鳖者",
          "disputes": [],
          "pathogenesis": "乃饮食饥饱之时，过于多食，不能一时消化，乃生鳖甲之虫",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "再用马尿一碗，加人尿半合，童便尤妙，饮之立消"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有生鸟鹊于头上臂上，外有皮一层包之",
          "disputes": [],
          "pathogenesis": "乃人不敬神道而戏弄之耳",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "必须用刀割破其皮",
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "以前生肌散敷之，外加神膏"
        },
        {
          "caseIndex": 2,
          "symptomText": "如人遍身生疙疽，或内如核块，或外似蘑菇，香蕈，木耳之状者",
          "disputes": [],
          "pathogenesis": "乃湿热而生也",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "当先用外药洗之，后用汤药消之则愈",
          "methodCategory": "奇治法",
          "formulaIds": ["shishi-formula-乃用煎"],
          "formulaText": "白术五钱，薏仁一两，芡实五钱，人参一两，茵陈三钱，白芥子三钱，半夏三钱，泽泻三钱，附子一钱，黄芩三钱，水煎服"
        },
        {
          "caseIndex": 3,
          "symptomText": "如人有腹中高硕，宛似坐胎者，形容憔悻，面目瘦黑，骨干毛枯",
          "disputes": [],
          "pathogenesis": "乃妇人淫心忽起，有物以凭之，才生此症",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用红花半斤，大黄五钱，雷丸三钱，水煎服"
        },
        {
          "caseIndex": 4,
          "symptomText": "如人有头角生疮，当日即头重如山，第二日即变青紫",
          "disputes": [],
          "pathogenesis": "此乃毒气攻心而死也。此病多得之好吃春药",
          "organs": ["心"],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "速以金银花一斤煎汤，饮之数十碗"
        },
        {
          "caseIndex": 5,
          "symptomText": "有人脚板下忽生二指，痛不可忍者",
          "disputes": [],
          "pathogenesis": "乃湿热之气结成",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用硼砂一分，瓦葱一两，冰片三分，人参一钱，为末"
        },
        {
          "caseIndex": 6,
          "symptomText": "如人有背上忽然疼痛，裂开一缝，窜出蛇一条",
          "disputes": [],
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "予乃用人参一两，半夏三钱，南星三钱，附子一钱，治之忽苏"
        },
        {
          "caseIndex": 7,
          "symptomText": "又有七孔流血者",
          "disputes": [],
          "pathogenesis": "亦肾虚热也",
          "organs": ["肾"],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "用六味地黄汤加麦冬三钱，五味子一钱，骨碎补一钱治之"
        }
      ]
    },
    {
      "clauseId": "shishi-0183",
      "contentHash": "f644fecd41c94721",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "如人有足上忽毛孔标血如一线者，流而不止即死",
          "disputes": [],
          "pathogenesis": "此症乃酒色不禁，恣意纵欲所致",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "急以米醋三升，煮滚热，以两足浸之，即止血"
        },
        {
          "caseIndex": 1,
          "symptomText": "脐中出血，亦是奇症",
          "disputes": [],
          "pathogenesis": "而出血皆是肾火之外越也",
          "organs": ["肾"],
          "relations": [],
          "treatmentPrinciple": "六味汤滋其水，则火自息焰矣",
          "methodCategory": "奇治法",
          "formulaIds": ["shishi-formula-shishi-0183-3"],
          "formulaText": "用六味汤加骨碎补"
        },
        {
          "caseIndex": 2,
          "symptomText": "如人有觉肠胃中痒而无处扒搔者，只觉置身无地",
          "disputes": [],
          "pathogenesis": "此乃火郁结而不散之故",
          "organs": ["胃"],
          "relations": [],
          "treatmentPrinciple": "法当用表散之药",
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用柴胡三钱，白芍一两，甘草二钱、炒栀子三钱。天花粉三钱，水煎服即愈"
        },
        {
          "caseIndex": 3,
          "symptomText": "如有人先遍身发痒，以锥刺之少已",
          "disputes": [],
          "pathogenesis": "此乃冤鬼索命之报也",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用人参一两，当归三两、荆芥三钱，水煎服"
        },
        {
          "caseIndex": 4,
          "symptomText": "如人有皮肤手足之间如蚯蚓唱歌者",
          "disputes": [],
          "pathogenesis": "此乃水湿生虫也",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用白术五钱，薏仁一两，芡实一两，生甘草三钱，黄芩二钱。附子三分，防风五分，水煎服即愈"
        },
        {
          "caseIndex": 5,
          "symptomText": "如有人臂上忽生头一个，眼耳口鼻俱全，且能呼人姓名",
          "disputes": [
            { "kind": "mistreatment", "claim": "如用刀割之", "rebuttal": "立刻死亡不救" }
          ],
          "pathogenesis": "此乃债主索负之鬼结成此奇病也",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用人参半斤，贝母三两，白芥子三两，茯苓三两，白术五两，生甘草三两，白矾二两，半夏二两，青盐三两"
        },
        {
          "caseIndex": 6,
          "symptomText": "如人舌吐出不肯收进",
          "disputes": [],
          "pathogenesis": "乃阳火盛强之故",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "以冰片少许，点之即收"
        },
        {
          "caseIndex": 7,
          "symptomText": "如人舌缩入喉咙，不能语言者",
          "disputes": [],
          "pathogenesis": "乃寒气结于胸腹之故",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "急用附子一钱，人参三钱，白术五钱，肉桂一钱，干姜一钱治之"
        },
        {
          "caseIndex": 8,
          "symptomText": "如人舌出血如泉者",
          "disputes": [],
          "pathogenesis": "乃心火旺极，血不藏经也",
          "organs": ["心"],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "当用六味地黄汤加槐花三钱"
        },
        {
          "caseIndex": 9,
          "symptomText": "有人唇上生疮，久则疮口出齿牙于唇上者",
          "disputes": [],
          "pathogenesis": "乃七情忧郁，火动生齿",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用柴胡三钱，白芍三钱，黄连一钱，当归三钱，川芎一钱，生地三钱，黄芩一钱，天花粉二钱，白果十个，水煎服"
        },
        {
          "caseIndex": 10,
          "symptomText": "人掌中忽高起一寸，不痛不痒",
          "disputes": [
            { "kind": "mistreatment", "claim": "倘以附子作汤饮之", "rebuttal": "则周身俱热，又引动胃火，掌肉不消而内症蜂起" }
          ],
          "pathogenesis": "此乃阳明经之火不散而郁于手也",
          "organs": ["胃"],
          "relations": [],
          "treatmentPrinciple": "法当用外药消之",
          "methodCategory": "奇治法",
          "formulaIds": ["shishi-formula-shishi-0183-1"],
          "formulaText": "方用附子一个煎汤，以手渍之，至凉而止"
        },
        {
          "caseIndex": 11,
          "symptomText": "有人鼻大如拳，疼痛欲死",
          "disputes": [],
          "pathogenesis": "此乃肺经之火热壅于鼻而不得泄",
          "organs": ["肺"],
          "relations": [],
          "treatmentPrinciple": "法当清其肺中之邪，去其鼻间之火可也",
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用黄芩三钱，甘草三钱，桔梗五钱，紫菀二钱。百部一钱，天门冬五钱，麦冬三钱。苏叶一钱，天花粉三钱，水煎服"
        },
        {
          "caseIndex": 12,
          "symptomText": "男子乳房，忽然壅肿如妇人之状，扪之痛欲死，经岁经年不效者",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "若疮毒，不能经久，必然外溃", "rebuttal": "今经岁经年壅肿如故，非痰毒而何" },
            { "kind": "drugDoubt", "claim": "或疑附子大热，诸痛皆属于火，似不可用", "rebuttal": "殊不知非附子不能入于至坚之内" }
          ],
          "pathogenesis": "乃阳明之毒气结于乳房之间也。然此毒非疮毒，乃痰毒也",
          "organs": ["胃"],
          "relations": [],
          "treatmentPrinciple": "法当消其痰，通其瘀",
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用金银花一两。蒲公英一两，天花粉五钱，白芥子五钱，附子一钱，柴胡二钱，白芍三钱，通草三钱，木通一钱，炒栀子三钱，茯苓三钱，水煎服"
        },
        {
          "caseIndex": 13,
          "symptomText": "人脚板中，色红如火",
          "disputes": [],
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": ["shishi-formula-shishi-0183-2"]
        }
      ]
    },
    {
      "clauseId": "shishi-0184",
      "contentHash": "b19697bce3877d97",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人手上皮上现蛇形一条，痛不可忍",
          "disputes": [],
          "pathogenesis": "此蛇乘人之睡，而作交感于人身，乃生此怪病",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "以刀刺之",
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "外用白芷为末"
        },
        {
          "caseIndex": 1,
          "symptomText": "喉中似有物行动，吐痰则痛更甚，身上皮肤开裂，有水流出",
          "disputes": [],
          "pathogenesis": "乃生蜈蚣于胃口之上",
          "organs": ["胃", "肺", "肾", "肝"],
          "relations": [
            { "from": "肺", "to": "肾", "kind": "生" },
            { "from": "肺", "to": "肝", "kind": "移邪" }
          ],
          "treatmentPrinciple": "所以引其外出，然后以药调治其气血自愈",
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用鸡一只，煮熟，五香调治"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有胃脘不时作痛，遇饥更甚，尤畏大寒，日日作楚",
          "disputes": [],
          "organs": ["胃"],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "予以大蒜三两，捣汁灌之"
        },
        {
          "caseIndex": 3,
          "symptomText": "更有人忽头面肿如斗大，看人小如三寸，饮食不思，呻吟如睡",
          "disputes": [],
          "pathogenesis": "此痰也",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "用瓜蒂散吐之"
        },
        {
          "caseIndex": 4,
          "symptomText": "中心闷甚，面赤不能饮食",
          "disputes": [],
          "pathogenesis": "予谓有虫在胸中，必得之食腥也",
          "organs": [],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "以半夏三钱，瓜蒂七个，甘草三钱，黄连一钱，陈皮一钱，人参三钱吐之"
        },
        {
          "caseIndex": 5,
          "symptomText": "耳内忽长肉一条，手不可近，色红带紫",
          "disputes": [],
          "pathogenesis": "此肾火腾烧于耳也",
          "organs": ["肾"],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "用硼砂一分，冰片一分点之"
        },
        {
          "caseIndex": 6,
          "symptomText": "人大腿肿痛，坚硬如石，痛苦异常",
          "disputes": [],
          "pathogenesis": "此亦崇凭之也",
          "organs": ["肝"],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "方用生甘草一两，白芍三两，水煎服"
        },
        {
          "caseIndex": 7,
          "symptomText": "人有心窝外忽然生疮如碗大，变成数口，能作人声叫喊",
          "disputes": [],
          "pathogenesis": "此乃忧郁不舒，而崇凭之也",
          "organs": ["心"],
          "relations": [],
          "methodCategory": "奇治法",
          "formulaIds": [],
          "formulaText": "用生甘草三两，人参五钱，白矾三钱，茯神三钱，金银花三两，水煎服"
        }
      ]
    },
