{
  "entries": [
    {
      "clauseId": "bianzheng-0301",
      "contentHash": "354ced52792b1a34",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": ["胆", "心"],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0301-1"],
          "formulaText": "此症用攸利汤亦可治",
          "keySentence": "此方用柴胡以和解胆中之邪"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有处得意之境，过于欢娱，尽情喜笑，遂至感寒畏风，口干舌苦",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为外感也", "rebuttal": "谁知内伤于心包乎" },
            { "kind": "misdiagnosis", "claim": "是欢娱者，正心包之职掌，喜乐何至相伤", "rebuttal": "惟喜乐太过，大笑不止，未免津干液燥耳" }
          ],
          "pathogenesis": "心包干燥，必盗心之气以自肥",
          "organs": ["心包", "心"],
          "relations": [],
          "treatmentPrinciple": "治法自宜急补心中之气，心气既旺，心包亦必同旺",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0302",
      "contentHash": "9c3fbb3796623afb",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": ["心", "心包"],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0302-1"],
          "formulaText": "此症用滋生汤亦效",
          "keySentence": "此方心与膻中均补之药也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有终日思虑忧愁，致面黄体瘦，感冒风邪",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为外感之病", "rebuttal": "谁知是内伤于脾肾乎" }
          ],
          "pathogenesis": "盖思则伤脾，忧则伤肾",
          "organs": ["脾", "胃", "肾", "肝"],
          "relations": [
            { "from": "肝", "to": "脾", "kind": "克" },
            { "from": "肝", "to": "胃", "kind": "克" }
          ],
          "treatmentPrinciple": "治法乌可散邪，而不扶正",
          "formulaIds": ["bianzheng-formula-bianzheng-0302-2"],
          "formulaText": "此症用复正汤亦妙",
          "keySentence": "此方补土之中，有补水之味，补水之内，有散邪之剂"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有动多气恼，大声骂詈，觉饮食坐卧居处晋接，无非可怒之场，遂至感触风邪，身热胸满，两胁作胀",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为风邪外感", "rebuttal": "谁知是肝经内伤乎" }
          ],
          "pathogenesis": "木郁不泄，木乃生火，火郁不宣，火乃生风",
          "organs": ["肝"],
          "relations": [],
          "treatmentPrinciple": "此风邪之所以易入，不可徒祛于外也",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0303",
      "contentHash": "355c8116abe8338e",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [
            { "kind": "mistreatment", "claim": "倘不用白芍为君，单用柴胡、栀子之类", "rebuttal": "虽风火亦能两平，肝中气血之虚，未能骤补，风火散后，肝木仍燥，怒气终不能解" }
          ],
          "organs": ["肝"],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0303-1"],
          "formulaText": "此症用却忿散亦妙",
          "keySentence": "此方治肝经之内火，内风也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有昼夜诵读不辍，眠思梦想，俱在功名，劳瘁不自知，饥饿不自觉，遂至感入风邪，咳嗽身热",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为外感之症", "rebuttal": "谁知内伤于肺乎" },
            { "kind": "mistreatment", "claim": "然肺为邪所侮，补肺则邪更旺", "rebuttal": "而肺愈难安" },
            { "kind": "mistreatment", "claim": "然补胃而不佐以散邪之品", "rebuttal": "则肺畏邪侵，未必能受胃气之益" }
          ],
          "pathogenesis": "夫诵读伤气，气伤则肺虚，而腠理亦虚，邪即随虚而入于肺",
          "organs": ["肺", "肾", "胃"],
          "relations": [{ "from": "胃", "to": "肺", "kind": "生" }],
          "treatmentPrinciple": "惟于胃中散邪，则邪畏土气之旺，听肺气自生，而邪乃遁矣",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0304",
      "contentHash": "b725cddeb7fb50d2",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": ["肺", "胃"],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0304-1"],
          "formulaText": "此症亦可用来复汤",
          "keySentence": "此方肺胃同治也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有终日高谈，连宵聚语，口干舌渴，精神倦怠，因而感冒风寒，头痛鼻塞，气急作喘",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为风邪外感", "rebuttal": "谁知是气血内伤乎" }
          ],
          "pathogenesis": "气属肺，血属肝，气血两伤，即肺肝之两伤也",
          "organs": ["肺", "肝"],
          "relations": [],
          "treatmentPrinciple": "仍治其肺肝之虚，少佐散邪之药则得矣",
          "formulaIds": ["bianzheng-formula-bianzheng-0304-2"],
          "formulaText": "此症用加减补中汤亦妙",
          "keySentence": "此方入肝、入肺，补气、补血、消痰、消火各各分治"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有贪眠乐卧，终日倘徉枕席之上，遂至风邪袭之，身痛背疼，发热恶风",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为风邪外感", "rebuttal": "谁知脾气之内伤乎" },
            { "kind": "mistreatment", "claim": "专治其风", "rebuttal": "必至损伤脾气" },
            { "kind": "commonPractice", "claim": "人不知用补脾之法", "rebuttal": "往往变证蜂起也" }
          ],
          "pathogenesis": "然过于睡卧，则脾气不醒，转足伤气，已虚益虚",
          "organs": ["脾"],
          "relations": [],
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0305",
      "contentHash": "8b414adc46bf8336",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": ["脾"],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0305-1"],
          "formulaText": "此症用加味益气汤亦妙",
          "keySentence": "补中益气汤正益脾圣药"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有终日呼卢，长夜斗叶，筋酸背痛，足重腹饥，以至感冒风邪，遍身皆痛，身发寒热",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为风邪外感", "rebuttal": "谁知血气内伤乎" },
            { "kind": "commonPractice", "claim": "为之医者，复昧其内伤之因，惟治其外感之病", "rebuttal": "正气益亏，邪气愈旺，非变为痨瘵之，必成为怯弱之疾矣" }
          ],
          "pathogenesis": "况呼卢斗叶，劳其心神，损伤气血为尤甚",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "故治法须大补气血，少加以和解之品",
          "formulaIds": ["bianzheng-formula-bianzheng-0305-2"],
          "formulaText": "此症用两治汤亦效",
          "keySentence": "此方乃气血兼补之方"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有争强好斗，或赤身罔顾，或流血不知，以致风入皮肤，畏寒发热，头疼胁痛",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为风邪外感", "rebuttal": "谁知筋骨之内伤乎" }
          ],
          "pathogenesis": "盖斗殴之时，必多动怒，怒起而肝叶开张，血多不藏而血自耗，肝血既耗，必取给于肾水",
          "organs": ["肝", "肾"],
          "relations": [],
          "treatmentPrinciple": "治法宜急救其虚",
          "formulaIds": []
        }
      ]
    },
    {
