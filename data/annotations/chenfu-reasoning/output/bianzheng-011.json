          "organs": ["肝", "肾"],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0306-1"],
          "formulaText": "此症用护骨散效",
          "keySentence": "四物汤补血之药，亦补髓之药也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有终日捕鱼，身入水中，时而发热，畏寒恶冷",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为风湿之外感也", "rebuttal": "谁知是肺气之闭塞乎" }
          ],
          "pathogenesis": "此热乃肺气之虚，不能敌邪而身热也",
          "organs": ["肺"],
          "relations": [],
          "treatmentPrinciple": "治法补其肺气为主，兼带利水之味",
          "formulaIds": []
        }
      ]
    },
    {
