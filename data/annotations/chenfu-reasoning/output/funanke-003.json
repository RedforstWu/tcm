      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "肺嗽之症",
          "disputes": [
            { "kind": "drugDoubt", "claim": "其补肺也明矣，奈何兼补肾乎", "rebuttal": "盖肺经之气, 夜必归于肾，若肺金为心火所伤，必求救于其子" }
          ],
          "pathogenesis": "本是肺虚",
          "organs": ["肺", "肾", "心"],
          "relations": [
