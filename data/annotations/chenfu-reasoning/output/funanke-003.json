        }
      ]
    },
    {
      "clauseId": "funanke-0082",
      "contentHash": "d63609b38a0209f9",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有感暑伤气，忽然吐血盈盆",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为阴虚也", "rebuttal": "不知阴虚吐血与阳虚不同" }
          ],
          "organs": ["胃"],
          "relations": [],
          "treatmentPrinciple": "法当清胃火，不必止血也",
          "formulaIds": ["funanke-formula-funanke-0082-1"],
          "keySentence": "然补正多于解暑"
        }
      ]
    },
    {
      "clauseId": "funanke-0083",
      "contentHash": "794642ad60ac66f4",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "其吐也，或倾盆而出，或冲口而来，一时昏晕，死在顷刻",
          "disputes": [
            { "kind": "mistreatment", "claim": "以止血治之", "rebuttal": "则气闷不安" },
            { "kind": "mistreatment", "claim": "以补血治之", "rebuttal": "则胸满不受" },
            { "kind": "mistreatment", "claim": "若不先舒其气，而遽止血", "rebuttal": "则愈激动肝火之气，必气愈旺而血愈吐矣" }
          ],
          "pathogenesis": "此症盖怒伤肝，不能平其气，以致吐血",
          "organs": ["肝"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0083-1"]
        }
