          "pathogenesis": "非肾水泛上为痰，即肾火沸腾为痰",
          "organs": ["肾"],
          "relations": [],
          "treatmentPrinciple": "当补肾以袪逐之",
          "formulaIds": ["funanke-formula-funanke-0061-1"],
          "keySentence": "此治水泛为痰之圣药也"
        }
      ]
    },
