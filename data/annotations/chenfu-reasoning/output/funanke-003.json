      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有喘而且嗽者",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为气虚而有风痰也", "rebuttal": "谁知是气虚不能归源于肾, 而肝木挟之作祟乎" },
            { "kind": "mistreatment", "claim": "倘以四磨四七汤治之", "rebuttal": "则不效矣" }
          ],
          "pathogenesis": "谁知是气虚不能归源于肾, 而肝木挟之作祟乎",
          "organs": ["肾", "肝"],
          "relations": [],
          "treatmentPrinciple": "法当峻补其肾，少助以引火之品，则气自归源于肾",
          "formulaIds": ["funanke-formula-funanke-0081-1"]
        },
        {
          "caseIndex": 1,
          "symptomText": "此方专治喘而脉微濇者",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
