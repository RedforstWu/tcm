    {
      "clauseId": "funanke-0073",
      "contentHash": "b81eeba9d957ea1e",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "气虚则嬴弱",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "气实者", "rebuttal": "非气实，乃正气虚而邪气实也" }
          ],
          "pathogenesis": "乃正气虚而邪气实也",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "法当用补正之药，而加袪逐之品，则正气足而邪气消矣",
          "formulaIds": ["funanke-formula-funanke-0073-1"]
        },
        {
          "caseIndex": 1,
          "symptomText": "气实则壮盛",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "实者另一方，\n\n白术 柴胡 甘草 栀子（ 各壹钱）"
        }
      ]
    },
    {
      "clauseId": "funanke-0074",
      "contentHash": "4b0a7bed5e0ab2bf",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "凡人气喘而上者",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为气有余也", "rebuttal": "殊不知气盛当作气虚看，有余当作不足看" },
            { "kind": "mistreatment", "claim": "若认作肺气之盛，而用苏叶桔梗百部豆根之类", "rebuttal": "去生远矣" },
            { "kind": "drugDoubt", "claim": "或疑人参乃健脾土之药，既宜补肾,　不宜多用人参", "rebuttal": "不知肾水大虚，在一时不能遽生，非急补其气, 则元阳一线必且断绝" }
          ],
          "pathogenesis": "久病之喘多气虚",
          "organs": ["肺", "肾", "命门"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0074-1"],
          "keySentence": "此方不治肺，而正所以治肺也"
        },
        {
          "caseIndex": 1,
          "symptomText": "凡实喘症，气大急，喉中必作声，肩必抬",
          "disputes": [],
          "pathogenesis": "初起之喘多实邪",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "实喘方用\n\n黄芩（ 贰钱） 柴胡 甘草（ 各伍分） 麦冬（ 叁钱）"
        }
      ]
    },
    {
      "clauseId": "funanke-0075",
      "contentHash": "98f32fc51d4fcca4",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "气少息，喉无声，肩不抬也",
          "disputes": [],
          "pathogenesis": "乃肾气大虚，脾气又复将绝, 故奔冲而上，欲绝未绝也",
          "organs": ["肾", "脾"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0075-1"]
        }
      ]
    },
    {
      "clauseId": "funanke-0076",
      "contentHash": "dc2dfec40a6e63ad",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [
            { "kind": "misdiagnosis", "claim": "此证似喘", "rebuttal": "而非实喘也" },
            { "kind": "mistreatment", "claim": "若非实喘治之", "rebuttal": "立死" }
          ],
          "pathogenesis": "盖气短乃肾气虚耗，气冲上焦, 壅塞于肺经不足之故也",
          "organs": ["肾", "肺"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0076-1"],
          "keySentence": "此方妙在用人参之多，能下达气原，挽回于无何有之乡"
        }
      ]
    },
    {
      "clauseId": "funanke-0077",
      "contentHash": "b86e2431033f9a8a",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "以致喘息肩抬气逆，痰吐不出，身不能卧",
          "disputes": [
            { "kind": "drugDoubt", "claim": "然徒用黄芩, 虽曰清火", "rebuttal": "转足以遏抑其火，而火未必伏也" }
          ],
          "pathogenesis": "人忽感风邪，寒入于肺",
          "organs": ["肺"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0077-1"],
          "keySentence": "此方妙在用柴胡、射干、桔梗，以发舒肺金之气"
        }
      ]
    },
    {
      "clauseId": "funanke-0078",
      "contentHash": "a7ae7e2d63a365d3",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有气喘不能卧，吐痰如涌泉者，舌不燥而喘不止，一卧即喘",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "此非外感之寒邪", "rebuttal": "乃肾中之寒气也" }
          ],
          "pathogenesis": "盖肾中无火，则水无所养，乃泛上而为痰",
          "organs": ["肾", "肺"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0078-1"]
        }
      ]
    },
    {
      "clauseId": "funanke-0079",
      "contentHash": "a24ced9880fb9615",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "以致作喘，甚有吐红粉痰者",
          "disputes": [],
          "pathogenesis": "此又肾火炎, 上以烧肺金，肺热不能克肝，而龙雷之火升腾矣",
          "organs": ["肾", "肝", "肺"],
          "relations": [{ "from": "肺", "to": "肝", "kind": "克" }],
          "formulaIds": ["funanke-formula-funanke-0079-1"],
          "keySentence": "此方妙在地骨皮清骨中之火"
        }
      ]
    },
    {
