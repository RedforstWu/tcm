{
  "entries": [
    {
      "clauseId": "bianzheng-0151",
      "contentHash": "f7ba5ef50f1f17f1",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0151-1",
            "bianzheng-formula-bianzheng-0151-2"
          ],
          "formulaText": "方用加减柴胡汤",
          "keySentence": "此方亦小柴胡之变方"
        },
        {
          "caseIndex": 1,
          "symptomText": "春月伤风四、五日，身热恶风，头项强，胁下满，手足温，口渴",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为太阳、阳明、少阳之合病",
              "rebuttal": "谁知是春温之症，有似伤寒而非真正伤寒也"
            },
            {
              "kind": "drugDoubt",
              "claim": "论理，泻少阳胆经之火足矣，此方并和其肝气，似乎太过",
              "rebuttal": "然胆经受邪，正因胆气之太郁也"
            }
          ],
          "pathogenesis": "盖春温之症，风伤于少阳也",
          "organs": [
            "胆",
            "肝"
          ],
          "relations": [],
          "treatmentPrinciple": "故治春温之症，止消单治少阳，而各经之病尽愈",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0151-3"
          ],
          "keySentence": "春温之病，每从肝胆以入邪，吾治其肝胆，则在表在里之邪无不尽散矣"
        },
        {
          "caseIndex": 2,
          "symptomText": "妇人经水适来，正当伤风，发热恶寒，胸胁胀满，谵语",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为伤寒结胸也",
              "rebuttal": "谁知是热入血室乎"
            }
          ],
          "pathogenesis": "女子热入血室者，乃血欲出而热闭之，血化为热也",
          "organs": [
            "肝",
            "胆"
          ],
          "relations": [],
          "treatmentPrinciple": "故治法亦不必大异，仍同导热汤治之",
          "formulaIds": [],
          "formulaText": "仍同导热汤治之"
        },
        {
          "caseIndex": 3,
          "symptomText": "伤风身热后，肢体骨节皆痛，手足寒甚",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为伤寒由三阳而传入于少阴也",
              "rebuttal": "谁知其人肾水素虚"
            },
            {
              "kind": "mistreatment",
              "claim": "若再用祛风之药",
              "rebuttal": "则肺气愈虚，益耗肾水，水亏而火旺，必有虚火腾空，反致生变"
            }
          ],
          "pathogenesis": "肺伤而不能生肾，则肾水更枯，不能灌注于一身之上下",
          "organs": [
            "肾",
            "肺"
          ],
          "relations": [
            {
              "from": "肺",
              "to": "肾",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "当急补其肾中之水，以安肾中之火，则水足以制火",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0151-4"
          ],
          "keySentence": "何若六味地黄汤直填肾水，使水火之既济也"
        },
        {
          "caseIndex": 4,
          "symptomText": "伤风后下利，咽痛，胸满心烦",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为伤寒邪入于少阴，乃阴寒上犯于心肺，而下犯于大肠也",
              "rebuttal": "伤风之后，身凉则邪已尽散，何阴邪之留乎"
            }
          ],
          "pathogenesis": "乃大肠之阴虚自利，非邪逼迫之也",
          "organs": [
            "大肠",
            "肾",
            "心",
            "心包",
            "肺"
          ],
          "relations": [
            {
              "from": "肺",
              "to": "肾",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "治法补水以济心，复补金以生肾",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0152",
      "contentHash": "ac84055db4cb0009",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [
            {
              "kind": "drugDoubt",
              "claim": "何加入肉桂以补命门之火，非仍是治少阴之寒邪乎",
              "rebuttal": "不知水非火不生，用肉桂数分，不过助水之衰，而非祛寒之盛"
            }
          ],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0152-1"
          ],
          "formulaText": "方用加味地黄汤",
          "keySentence": "故特加肉桂于水中而补火也"
        },
        {
          "caseIndex": 1,
          "symptomText": "春月伤风二、三日，咽中痛甚",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为少阴之火，寒逼之也",
              "rebuttal": "谁知是少阴之寒，火逼之乎"
            }
          ],
          "pathogenesis": "伤风咽痛，乃下热虚火，逼其寒而上行",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "伤风之咽痛，必须补正以祛寒",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0153",
      "contentHash": "b7e6abe40f33c554",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0153-1"
          ],
          "formulaText": "方用补喉汤"
        },
        {
          "caseIndex": 1,
          "symptomText": "春月伤风，身热下利六、七日，咳而呕，心烦不得眠",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为邪入少阴而成下利，以致呕咳、心烦不眠也",
              "rebuttal": "谁知春温之病多有如此，症相同而治法宜别"
            },
            {
              "kind": "mistreatment",
              "claim": "盖伤寒之治，利其水",
              "rebuttal": "而春温之治，不可徒利其水也"
            }
          ],
          "pathogenesis": "其脾土之衰可知，咳而呕，不特脾衰而胃亦衰矣",
          "organs": [
            "脾",
            "胃",
            "肺",
            "肾",
            "心"
          ],
          "relations": [],
          "treatmentPrinciple": "治法健其脾胃，益其心肾，不必又顾其风邪也",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0154",
      "contentHash": "e49165d64ece0926",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0154-1"
          ],
          "formulaText": "方用正治汤",
          "keySentence": "此方心、肾、脾、胃、肺五者兼治之药"
        },
        {
          "caseIndex": 1,
          "symptomText": "春月伤风，手足逆冷，脉紧，心下满而烦，饥不能食",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为伤寒之症，邪入厥阴结于胸中也",
              "rebuttal": "是伤风而非伤寒"
            },
            {
              "kind": "mistreatment",
              "claim": "倘作伤寒治法，而用瓜蒂吐之",
              "rebuttal": "必有脏腑反复之忧也"
            }
          ],
          "pathogenesis": "寒风入肝，手足必然逆冷，肝气拂抑，而心气亦何能顺泰乎",
          "organs": [
            "肝",
            "心",
            "脾",
            "胃"
          ],
          "relations": [
            {
              "from": "心",
              "to": "脾",
              "kind": "生"
            },
            {
              "from": "肝",
              "to": "脾",
              "kind": "克"
            },
            {
              "from": "肝",
              "to": "胃",
              "kind": "克"
            }
          ],
          "treatmentPrinciple": "但解肝中之寒，而木中之风自散",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0154-2"
          ],
          "keySentence": "得肉桂则直入肝中，以扫荡其寒风"
        },
        {
          "caseIndex": 2,
          "symptomText": "春月伤风，忽然发厥，心下悸",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为伤寒中，有不治厥则水渍入胃之语，得毋伤风亦可同治乎",
              "rebuttal": "不知伤寒之悸，恐其邪之下行而不可止；伤风之悸，又虑其邪之上冲而不可定"
            }
          ],
          "pathogenesis": "风性属阳，阳则升上",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "伤风宜先定悸而后治其厥也",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0155",
      "contentHash": "f4d28d84cd9a4085",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0155-1"
          ],
          "formulaText": "方用定悸汤",
          "keySentence": "此方止定悸而治厥已寓其内"
        },
        {
          "caseIndex": 1,
          "symptomText": "春温之症，满身疼痛，夜间发热，日间则凉",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为伤寒少阳之症也",
              "rebuttal": "谁知是肾肝之阴气大虚，气行阳分则病轻，气行阴分则病重乎"
            },
            {
              "kind": "misdiagnosis",
              "claim": "何以春温之症，阴虚而阳独不虚耶",
              "rebuttal": "不知肝肾之中，原有阳气，阴虚者，阳中之阴虚也"
            }
          ],
          "pathogenesis": "肾肝之阴气大虚",
          "organs": [
            "肾",
            "肝"
          ],
          "relations": [],
          "treatmentPrinciple": "治法补其肝肾之阴，则阴与阳平，内外两旺，而后佐之以攻风邪",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0156",
      "contentHash": "d24b031dc79fe817",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0156-1"
          ],
          "formulaText": "方用补夜丹",
          "keySentence": "此方乃补阴之神剂，亦转阳之圣丹，用攻于补之中，亦寓抚于剿之内也"
        },
        {
          "caseIndex": 1,
          "symptomText": "春温之症，日间发热，口干舌燥，至夜身凉，神思安闲，似疟非疟",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为伤寒症中如疟之病也",
              "rebuttal": "谁知是伤风而邪留于阳分乎"
            }
          ],
          "pathogenesis": "阳邪乘阳气之虚，尤为易入，以阳气之不能敌耳",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "治法于补阳之中，而用攻邪之药",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0157",
      "contentHash": "6405baba36dc2faa",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0157-1"
          ],
          "formulaText": "方用助气走邪散",
          "keySentence": "此方乃补正以祛邪也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有春月感冒风寒，咳嗽面白，鼻流清涕",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为外邪之盛，而肺受之",
              "rebuttal": "谁知是脾肺气虚，而外邪乘之乎"
            }
          ],
          "pathogenesis": "是邪之入肺乃肺自召之，非外邪之敢于入肺也",
          "organs": [
            "脾",
            "肺"
          ],
          "relations": [],
          "treatmentPrinciple": "故补气以祛邪，不若提气以祛邪之更胜也",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0157-2"
          ],
          "keySentence": "用升麻、柴胡以提气，且二味升中带散，内伤而兼外感者，尤为相宜"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有春日感冒风寒，身热发谵",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为阳明之内热也",
              "rebuttal": "谁知是肺热之逼肺乎"
            },
            {
              "kind": "mistreatment",
              "claim": "若以冬寒治法治春温",
              "rebuttal": "反致伤命为可惜也"
            }
          ],
          "pathogenesis": "肺得风邪则肺气大伤，寒必变热",
          "organs": [
            "肺",
            "胃"
          ],
          "relations": [],
          "treatmentPrinciple": "但治肺而不治胃，则胃气无伤，而肺邪易散",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0158",
      "contentHash": "5c37ad5088d2e95f",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0158-1"
          ],
          "formulaText": "方用宜春汤",
          "keySentence": "此方散肺经之邪火，又不犯阳明之胃气，肺气安而胃火亦静矣，此所以治肺而不必治胃耳"
        },
        {
          "caseIndex": 1,
          "symptomText": "春温之症，头痛身热，口渴呼饮，四肢发斑，似狂非狂，似躁非躁，沿门阖室，彼此传染",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为伤寒之疫症也",
              "rebuttal": "谁知是伤风之时症乎"
            },
            {
              "kind": "mistreatment",
              "claim": "倘以治伤寒之法治之",
              "rebuttal": "必至变生不测"
            },
            {
              "kind": "commonPractice",
              "claim": "虽时气之病亦多死亡",
              "rebuttal": "然皆治之不得其法，乃医杀之，非时气杀之也"
            }
          ],
          "pathogenesis": "肺气不宣，胃气不升，火郁于皮毛腠理之中",
          "organs": [
            "肺",
            "胃"
          ],
          "relations": [],
          "treatmentPrinciple": "治法补其脏腑，而少佐以解火祛邪之药",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0159",
      "contentHash": "948b06e6e19b2f42",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0159-1",
            "bianzheng-formula-bianzheng-0159-2"
          ],
          "formulaText": "方用远邪汤",
          "keySentence": "此方却邪而不伤正气，治不正之时症最效，不止治春温之时病也"
        }
      ]
    },
    {
      "clauseId": "bianzheng-0160",
      "contentHash": "94b3192884581623",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "阳明火起发狂，腹满不得卧，面赤而热，妄见妄言",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "谓是外邪之助乎",
              "rebuttal": "不知土中之火，乃心中之火也"
            },
            {
              "kind": "drugDoubt",
              "claim": "论理内热之火既起于心，宜泻心，而反泻胃者",
              "rebuttal": "恐胃火太盛，必致变生不测也"
            }
          ],
          "pathogenesis": "心火起而阳明之火翕然而发",
          "organs": [
            "心",
            "胃"
          ],
          "relations": [],
          "treatmentPrinciple": "必须急灭其火，以救燎原之势",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0160-1"
          ],
          "keySentence": "此方退胃火之神剂也"
        },
        {
          "caseIndex": 1,
          "symptomText": "热病有完谷不化，奔迫直泻者",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为大肠之火也",
              "rebuttal": "谁知是胃火太盛乎"
            },
            {
              "kind": "misdiagnosis",
              "claim": "第肾虚为寒而胃何以反能热耶",
              "rebuttal": "不知肾虚者水虚也"
            },
            {
              "kind": "mistreatment",
              "claim": "但遽泻胃火",
              "rebuttal": "则胃土因火而崩，胃水随土而泄，又不能底止"
            }
          ],
          "pathogenesis": "盖胃为肾之关，肾虚则胃之关门不守，胃乃挟水谷之气而下行矣",
          "organs": [
            "胃",
            "肾",
            "命门",
            "大肠"
          ],
          "relations": [],
          "treatmentPrinciple": "必须先健其土，而分利其水",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0161",
      "contentHash": "b0884341dfd95dfd",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0161-1"
          ],
          "formulaText": "方用缓流汤",
          "keySentence": "肾得补而真阴生，龙雷之火自仍归于肾脏"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有口干舌燥，面目红赤，易喜易笑者",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为心火热极也",
              "rebuttal": "谁知是心包膻中之火炽甚乎"
            },
            {
              "kind": "mistreatment",
              "claim": "然而泻心包必至有损于心",
              "rebuttal": "心虚而心包之气更虚，必至心包之火更盛"
            }
          ],
          "pathogenesis": "夫心包之火，相火也，相火者，虚火也",
          "organs": [
            "心包",
            "心"
          ],
          "relations": [],
          "treatmentPrinciple": "不如专补其心，心气足而心包之火自安其位",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0162",
      "contentHash": "a248f9b92a73362b",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [
            {
              "kind": "drugDoubt",
              "claim": "此方补心气之虚，仍是补心包之火，何以火得之而反息也",
              "rebuttal": "不知心火宜泻以为补，而心包之火宜补以为泻"
            }
          ],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0162-1"
          ],
          "formulaText": "方用归脾汤",
          "keySentence": "补其心而心包不敢夺心之权"
        },
        {
          "caseIndex": 1,
          "symptomText": "鼻中出黑血不止",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "得毋疑为肾火之刑母乎",
              "rebuttal": "夫肾为肺金之子，安有子杀其母者"
            }
          ],
          "pathogenesis": "乃心热之极，火刑肺金也",
          "organs": [
            "心",
            "肺",
            "肾"
          ],
