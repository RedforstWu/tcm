    {
      "clauseId": "bianzheng-0126",
      "contentHash": "4e47f9d813ec5e54",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有饮食入胃而即吐者",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "而无如人以为胃病也",
              "rebuttal": "此肝木克胃土也"
            },
            {
              "kind": "mistreatment",
              "claim": "杂用香砂消导之剂",
              "rebuttal": "反伤胃气，愈增其吐"
            },
            {
              "kind": "mistreatment",
              "claim": "复改用寒凉之味，以降其火",
              "rebuttal": "不独胃伤而脾亦伤矣"
            }
          ],
          "pathogenesis": "肾水不足，力不能润灌于胃中，又何能分济于咽喉乎",
          "organs": [
            "肝",
            "胃",
            "肾",
            "大肠"
          ],
          "relations": [
            {
              "from": "肝",
              "to": "胃",
              "kind": "克"
            }
          ],
          "treatmentPrinciple": "治法必须大补其肾中之水",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0126-1"
          ],
          "keySentence": "此方纯补精血，水足而胃中有津，大肠有液，自然上下相通而无阻滞之患"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有朝食暮吐，或暮食朝吐，或食之一日至三日而尽情吐出者",
          "disputes": [
            {
              "kind": "mistreatment",
              "claim": "补火而不兼补其水",
              "rebuttal": "焚烧竭泽，必成焦枯之患"
            }
          ],
          "pathogenesis": "食久而始吐者，乃肾中之无火也",
          "organs": [
            "肾",
            "命门",
            "脾",
            "胃"
          ],
          "relations": [
            {
              "from": "命门",
              "to": "脾",
              "kind": "生"
            },
            {
              "from": "命门",
              "to": "胃",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "治法宜急补肾中之火",
          "formulaIds": []
        }
      ]
    },
