          "formulaIds": [
            "bianzheng-formula-bianzheng-0121-1"
          ],
          "formulaText": "方用白通汤治之",
          "keySentence": "方中原是大热之味，得人尿、猪胆以乱之，则下咽觉寒，而入腹正热，阳可重回，而阴可立散，自然脉通而关启矣"
        }
      ]
    },
    {
      "clauseId": "bianzheng-0122",
      "contentHash": "da24d454dafa6582",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有饮食之后，胸中倒饱",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为多食而不能消",
              "rebuttal": "谁知中满之症，实由于脾土之衰，而脾气之衰，又由于肾火之寒也"
            },
            {
              "kind": "mistreatment",
              "claim": "用牵牛、甘遂之药，以逐其水",
              "rebuttal": "内原无水湿之邪，水未见出，而正气益虚，胀满更急"
            },
            {
              "kind": "commonPractice",
              "claim": "犹然开鬼门、泄净府，持论纷纭，各执己见",
              "rebuttal": "皆操刀下石之徒也"
            }
          ],
          "pathogenesis": "实由于脾土之衰，而脾气之衰，又由于肾火之寒也",
          "organs": [
            "脾",
            "肾"
          ],
          "relations": [],
          "treatmentPrinciple": "倘用温补之药，早健其脾气",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0122-1"
          ],
          "keySentence": "此方但去补脾，绝不消导以耗其气"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有未见饮食则思，既见饮食则厌，乃勉强进用，饱塞于上脘之间，微微胀闷",
          "disputes": [],
          "pathogenesis": "此不止胃气之虚。而心包之火正衰也",
          "organs": [
            "心包",
            "胃"
          ],
          "relations": [
            {
              "from": "心包",
              "to": "胃",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "必须补胃土，而兼补心包之火也",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0123",
      "contentHash": "eb8ac33b9c0d24df",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0123-1"
          ],
          "formulaText": "方用生胃进食汤",
          "keySentence": "此方治胃，无非治心包也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有中心郁郁不舒，久则两胁饱满，饮食下喉，即便填胀，不能消化",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为臌胀之渐也",
              "rebuttal": "而不知皆气滞之故"
            },
            {
              "kind": "mistreatment",
              "claim": "倘用逐水之药",
              "rebuttal": "必且更甚"
            },
            {
              "kind": "mistreatment",
              "claim": "用消食之药",
              "rebuttal": "亦止可取一时之快，而不能去永久之胀也"
            }
          ],
          "pathogenesis": "皆气滞之故",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "法宜开郁为主",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0124",
      "contentHash": "7c6d2807f7ccb623",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0124-1"
          ],
          "formulaText": "方用快膈汤",
          "keySentence": "此方解郁而无刻削之忧，消胀而无壅塞之苦，攻补兼施，自易收功也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有患中满之病，饮食知味，但多食则饱闷不消",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为脾气之虚",
              "rebuttal": "谁知是肾气之虚乎"
            },
            {
              "kind": "mistreatment",
              "claim": "若作水肿治之",
              "rebuttal": "则丧亡指日矣"
            },
            {
              "kind": "commonPractice",
              "claim": "人不知补肾火以生脾土，反用泻水之法以伤脾",
              "rebuttal": "无异决水以护土，土有不崩者哉"
            },
            {
              "kind": "drugDoubt",
              "claim": "或疑土亏无以制水，又补肾以生水，不益增波以添胀哉",
              "rebuttal": "不知肾中之水，乃真水也，邪水欺火以侮土，真水助火以生土，实有不同"
            }
          ],
          "pathogenesis": "惟肾火既虚，而土失其刚坚之气，土遂不能容物而容水",
          "organs": [
            "肾",
            "脾",
            "命门"
          ],
          "relations": [
            {
              "from": "肾",
              "to": "脾",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "故肾虚中满，必补火以生土；又必补水以生火耳",
          "formulaIds": []
        }
      ]
    },
