      "contentHash": "4e4fc95249c05f9c",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [
            {
              "kind": "drugDoubt",
              "claim": "夫驴溺何以能杀虫而止吐也",
              "rebuttal": "驴性属金，虫性畏金，故取而用之"
            }
          ],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0129-1"
          ],
          "formulaText": "方用健土杀虫汤",
          "keySentence": "健土杀虫汤，补脾胃以扶土，即泻肝以平木"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有食后必吐出数口，却不尽出，膈上时作声，面色如平人",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为脾胃中之气塞也",
              "rebuttal": "谁知是膈上有痰血相结而不散乎"
            }
          ],
          "pathogenesis": "气血阻住，津液遂聚而成痰，痰聚而成饮，与血相搏而不静，则动而成声",
          "organs": [
            "胃",
            "肝"
          ],
          "relations": [],
          "treatmentPrinciple": "但去其膈上之痰血，而吐病不治而自愈也",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0129-2"
          ],
          "keySentence": "得半夏、天花粉以荡痰，得韭汁以逐血"
        }
      ]
    },
    {
      "clauseId": "bianzheng-0130",
      "contentHash": "34935f06fb884aa2",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有两足跗上先肿，渐渐肿胀至腹，按胀上如泥之可搏，小便不利，大便反结",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "非水肿也",
              "rebuttal": "此由土气之郁"
            },
            {
              "kind": "drugDoubt",
              "claim": "论理，牵牛、甘遂之方未尝不可用",
              "rebuttal": "但虑世人天禀日薄，而脾、胃、肾三经多虚，恐不胜药力之过迅"
            }
          ],
          "pathogenesis": "由于肾气之虚，则土无升腾之气，而土乃郁而不伸，力不能制水，使水来相侮",
          "organs": [
            "脾",
            "胃",
            "肾",
            "膀胱"
          ],
          "relations": [
            {
              "from": "肾",
              "to": "脾",
              "kind": "侮"
            }
          ],
          "treatmentPrinciple": "下体胀而上身未胀，正初起之病，宜急泄其水之为得",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0130-1"
          ],
          "keySentence": "于补中泻水，正气无伤而邪水尽出之为妙"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有水肿既久，遍身手足俱胀，面目亦浮，口不渴而皮毛出水，手按其肤如泥",
          "disputes": [],
          "pathogenesis": "此真水臌也，乃土气郁塞之甚故耳",
          "organs": [
            "脾",
            "胃"
          ],
          "relations": [],
          "treatmentPrinciple": "不用下夺之法，何以泻滔天之水哉",
          "formulaIds": []
        }
      ]
    },
