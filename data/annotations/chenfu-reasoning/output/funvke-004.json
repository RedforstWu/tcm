      "contentHash": "5f007a1a90b0fdd2",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "胎前或患伤寒、疫症、疟疾，热久必致堕胎，堕后愈增热",
          "disputes": [
            { "kind": "mistreatment", "claim": "治者甚勿妄论伤寒，疟疫未除，误投栀子豉汤、柴、芩、连、柏等药", "rebuttal": "只重产轻邪，大补气血，频服生化汤" },
            { "kind": "mistreatment", "claim": "若热用寒剂", "rebuttal": "愈虚中气，误甚" }
          ],
          "pathogenesis": "因热消阴血，而又继产失血故也",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "只重产轻邪，大补气血",
          "formulaIds": [],
          "formulaText": "频服生化汤"
        }
      ]
    },
    {
