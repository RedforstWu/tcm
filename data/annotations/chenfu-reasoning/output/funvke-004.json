      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "若产时劳甚，血崩形脱",
          "disputes": [
            { "kind": "commonPractice", "claim": "有治产不用当归者", "rebuttal": "见偏之甚" },
            { "kind": "commonPractice", "claim": "世以四物汤治产", "rebuttal": "地黄性寒滞血，芍药微酸无补，伐伤生气，误甚" }
          ],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "生化汤先连进二服"
        }
      ]
    },
    {
      "clauseId": "funvke-0094",
      "contentHash": "266a81f6a9132708",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "产后危疾诸症",
          "disputes": [
            { "kind": "mistreatment", "claim": "一因气不舒而误用耗气顺气等药", "rebuttal": "反增饱闷" },
            { "kind": "mistreatment", "claim": "二因伤气而误用消导", "rebuttal": "反损胃气，至绝谷" },
            { "kind": "mistreatment", "claim": "三因身热而误用寒凉", "rebuttal": "必致损胃增热" },
            { "kind": "mistreatment", "claim": "九毋用山楂汤以攻块定痛", "rebuttal": "而反损新血" }
          ],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "当频服生化汤，随症加减"
        }
      ]
    },
    {
      "clauseId": "funvke-0095",
      "contentHash": "35aa331967222ec7",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "凡新产后，荣卫俱虚，易发寒热；身痛腹痛",
          "disputes": [
            { "kind": "mistreatment", "claim": "决不可妄投发散之剂", "rebuttal": "当用生化汤为主，稍佐发散之药" },
            { "kind": "commonPractice", "claim": "世人见有身热，便以为外感，遽然发汗", "rebuttal": "速亡甚矣" },
            { "kind": "mistreatment", "claim": "若偏补气而专用参耆", "rebuttal": "非善也" },
            { "kind": "drugDoubt", "claim": "或云大热而用姜何也", "rebuttal": "曰此热非有余之热，乃阴虚内生热耳" }
          ],
          "pathogenesis": "此热非有余之热，乃阴虚内生热耳",
          "organs": ["脾"],
          "relations": [],
          "treatmentPrinciple": "大抵产后先宜补血，次补气",
          "formulaIds": [],
          "formulaText": "当用生化汤为主，稍佐发散之药"
        },
        {
          "caseIndex": 1,
          "symptomText": "产后寒热，口眼歪邪",
          "disputes": [],
          "pathogenesis": "此乃气血虚甚",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "以大补为主",
          "formulaIds": []
        }
      ]
    },
    {
