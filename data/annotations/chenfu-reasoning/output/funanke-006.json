{
  "entries": [
    {
      "clauseId": "funanke-0151",
      "contentHash": "95003aa6bdb0e43a",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "筋骨牵引，坐卧不得，时时走易不定",
          "disputes": [],
          "pathogenesis": "此是涎伏在心膈上下",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "治法用控涎丹"
        }
      ]
    },
    {
      "clauseId": "funanke-0152",
      "contentHash": "40c1a2de7abed7e6",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "pathogenesis": "此症乃肾水衰耗，不能上润于脑，则河车之路，干涩而难行，故作痛也",
          "organs": ["肾"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0152-1"],
          "keySentence": "此方补气补水，去湿去风，润筋滋骨"
        }
      ]
    },
    {
      "clauseId": "funanke-0153",
      "contentHash": "c61dd91ddc632b7b",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [
            { "kind": "misdiagnosis", "claim": "治腰乎，治头乎", "rebuttal": "谁知是肾气不通乎" },
            { "kind": "drugDoubt", "claim": "今并头而亦愈者何也", "rebuttal": "盖此头痛,是肾气不上达之故" }
          ],
          "pathogenesis": "盖肾气上通于脑，而脑气下达于肾，上下虽殊，而气实相通",
          "organs": ["肾"],
          "relations": [],
          "treatmentPrinciple": "法当用温补之药,以大益其肾中之阴，则上下之气通矣",
          "formulaIds": ["funanke-formula-funanke-0153-1"],
          "keySentence": "盖此头痛,是肾气不上达之故，用补肾之味，则肾气旺而上通于脑"
        }
      ]
    },
    {
      "clauseId": "funanke-0154",
      "contentHash": "f0b151cca5ad7173",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "寒气侵心者,手足反温",
          "disputes": [],
          "pathogenesis": "一则寒气侵心而痛",
          "organs": ["心", "心包"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0154-1"]
        },
        {
          "caseIndex": 1,
          "symptomText": "火气焚心者，手足反冷",
          "disputes": [],
          "pathogenesis": "一则火气焚心而痛",
          "organs": ["心", "心包"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "黑栀（ 叁钱） 白术（ 伍钱） 甘草 半夏 柴胡（ 各壹钱）"
        }
      ]
    },
    {
      "clauseId": "funanke-0155",
      "contentHash": "6b392c3a28572bb6",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "如恶寒见水如仇，火熨之则快",
          "disputes": [],
          "pathogenesis": "木衰不能生火,则包络寒",
          "organs": ["心包", "肝", "心"],
          "relations": [{ "from": "肝", "to": "心", "kind": "生" }],
          "treatmentPrinciple": "补肝而邪自退",
          "formulaIds": ["funanke-formula-funanke-0155-1"]
        },
        {
          "caseIndex": 1,
          "symptomText": "如见水喜悦，手按之而转痛者",
          "disputes": [],
          "pathogenesis": "若包络之热，由于肝经之热",
          "organs": ["心包", "肝"],
          "relations": [],
          "treatmentPrinciple": "泻肝而火自消也",
          "formulaIds": ["funanke-formula-funanke-0155-2"],
          "keySentence": "若包络之热，由于肝经之热,泻肝而火自消也"
        }
      ]
    },
    {
      "clauseId": "funanke-0156",
      "contentHash": "20f672d32315b495",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "痛不可忍，按之愈痛，口渴饮以凉水，则痛少止，少顷依然大痛",
          "disputes": [],
          "pathogenesis": "此火结在大小肠也",
          "organs": ["大肠", "小肠"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0156-1"],
          "keySentence": "此方舒肝经之气，利膀胱之水，泻水逐瘀"
        },
        {
          "caseIndex": 1,
          "symptomText": "腹中有痞块，一时发作，而痛不可手按者",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0156-2"]
        },
        {
          "caseIndex": 2,
          "symptomText": "冷气心腹痛",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "火龙丹"
        }
      ]
    },
    {
      "clauseId": "funanke-0157",
      "contentHash": "babb7e281c9d2e4a",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人病不能饮食，或食而不化，作痛作满，或兼吐泻",
          "disputes": [],
          "pathogenesis": "此肝木克脾土也",
          "organs": ["肝", "脾"],
          "relations": [{ "from": "肝", "to": "脾", "kind": "克" }],
          "formulaIds": ["funanke-formula-funanke-0157-1"],
          "keySentence": "此右病而左治之也"
        }
      ]
    },
    {
      "clauseId": "funanke-0158",
      "contentHash": "6db35e4359d60f27",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "pathogenesis": "此乃气虚而寒湿中之",
          "organs": [],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0158-1"]
        }
      ]
    },
    {
      "clauseId": "funanke-0159",
      "contentHash": "f0c34eff06b741e0",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "十指皆麻，面目失色",
          "disputes": [],
          "pathogenesis": "此亦气虚也",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "治当补中益气汤, 加木香麦冬香附羌活乌药防风"
        }
      ]
    },
    {
      "clauseId": "funanke-0160",
      "contentHash": "8174305059a2dbf8",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "手足麻木为中风之候",
          "disputes": [],
          "pathogenesis": "盖手太阴肺经行于手大指，肺藏气而右降，气分虚则病偏于右,足厥阴肝经行于足大指，肝藏血而左升，血分虚则病偏于左",
          "organs": ["肺", "肝"],
          "relations": [],
          "treatmentPrinciple": "故手足麻木必补气血",
          "formulaIds": [],
          "formulaText": "四物汤加人参、白术、茯苓、陈皮、半夏、桂枝、柴胡、羌活、防风、秦艽、牛膝炙草"
        }
      ]
    },
    {
      "clauseId": "funanke-0161",
      "contentHash": "d99213b8b91bb9c9",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "pathogenesis": "凡木是湿痰死血也",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "用四物汤加陈皮、半夏、茯苓、桃仁、红花、白芥子、甘草、竹沥、姜汁"
        }
      ]
    },
    {
