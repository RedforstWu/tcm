    },
    {
      "clauseId": "funanke-0166",
      "contentHash": "2fd29464d9aa1fbd",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "此症不能步履",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为肾水之虚", "rebuttal": "谁知由于气虚而不能运动乎" }
          ],
          "pathogenesis": "谁知由于气虚而不能运动乎",
          "organs": [],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0166-1"]
        }
      ]
    },
    {
      "clauseId": "funanke-0167",
      "contentHash": "092cd00ed05784b2",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人若筋急拳缩伛偻，而不能直立者",
          "disputes": [
            { "kind": "drugDoubt", "claim": "何又用柴胡", "rebuttal": "夫肝为筋之主，筋乃肝之余，气不顺，筋自缩急" }
          ],
          "pathogenesis": "然筋之舒,在于血和，而脉之平，在于气足",
          "organs": ["肝"],
          "relations": [],
          "treatmentPrinciple": "故治筋必须先治血，而治脉必须补气",
          "formulaIds": ["funanke-formula-funanke-0167-1"],
          "keySentence": "此方妙在用柴胡一味，入于补药中"
        }
      ]
    },
    {
      "clauseId": "funanke-0168",
      "contentHash": "47616576261cdeb2",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "遍身作痛，筋骨尤甚,不能伸屈，口渴目赤头眩，痰壅胸不利，小便短赤，夜间殊甚，又遍身作痒如虫行",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为风也", "rebuttal": "谁知是肾气虚而热也" }
          ],
          "pathogenesis": "谁知是肾气虚而热也",
          "organs": ["肾"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "法用六味地黄汤加栀子柴胡"
        }
      ]
    },
    {
