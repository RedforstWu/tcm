      "contentHash": "46d70852eafe6e0d",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "凡人身体麻木不仁，两目羞明怕日，眼涩难开，视物昏花，睛痛",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0164-1"]
        }
