    {
      "clauseId": "funanke-0165",
      "contentHash": "c7f1e5b078ad53fc",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "或痛或麻木",
          "disputes": [],
          "pathogenesis": "风寒湿三气，合而成疾，客于皮肤肌肉之间",
          "organs": [],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0165-1"]
        }
