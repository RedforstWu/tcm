{
  "entries": [
    {
      "clauseId": "bianzheng-0361",
      "contentHash": "fe54c01b5d076846",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0361-1"],
          "keySentence": "此方白芷、雄黄俱是制蛇之药，而山楂、丹砂善化鱼肉之味，合而用之，则鳖毒易消"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有道途之间，误服汗之药，以致头重脚轻，口吐涎沫，眼瞪不语",
          "disputes": [
            { "kind": "commonPractice", "claim": "世人以凉水解之，亦能少醒", "rebuttal": "但凉水入心，水停心下，倘系虚人，必变他症，非解法之善也" }
          ],
          "pathogenesis": "此迷心之故也",
          "organs": ["心"],
          "relations": [],
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0362",
      "contentHash": "25a80b190d0e588b",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [
            { "kind": "drugDoubt", "claim": "或问汗药必是痰迷心窍，宜用生姜以开之，何故不用？", "rebuttal": "不知汗药中用天仙子居多，天仙子得姜而愈迷其心矣" }
          ],
          "organs": ["心"],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0362-1"],
          "keySentence": "盖茯苓通其心，生甘草解其毒，陈皮清其痰，宽其中，又得瓜蒂上通，使药不停心"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有游两粤之间，或与妇女交好，或与男子成仇，多下蛊毒于饮食之中，人食之则面目渐黄，饮食倦怠",
          "disputes": [
            { "kind": "commonPractice", "claim": "世传蛊毒，土人将各毒虫与蛇、竭等物投于缸中，听其彼此相食，食完止存一物，不死者，取之以为蛊母", "rebuttal": "此讹也。盖彼地别有蛊药，乃天生之毒也" },
            { "kind": "mistreatment", "claim": "倘徒用矾石", "rebuttal": "不更虚其虚乎" }
          ],
          "pathogenesis": "又得蛊毒结于胸腹之间，必然正气大虚",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "必须于补气补血之中，而加用消痰化蛊之药，则有益无损，始称万全",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0363",
      "contentHash": "3e18783cde6f7fb1",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0363-1", "bianzheng-formula-bianzheng-0363-2"],
          "keySentence": "此方补气血之亏，化痰涎之块。正气既旺，邪气自消"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有误食竹间之蕈，或轻吞树上之菌，遂至胸胀心疼，腹痛肠泻而死",
          "disputes": [],
          "pathogenesis": "其味最美，而其气实毒也",
          "organs": [],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0363-3"],
          "keySentence": "盖生甘草原是解毒之神品，又得白芷，最解蛇毒"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有食牛、犬之肉，一时心痛，欲吐不能，欲泻不可",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "夫牛、犬乃资补精血之物，何以有毒？", "rebuttal": "此必牛、犬抱病将死未死之时，又加束缚，以激动其怒气，毒结于皮肉心肝之间" }
          ],
          "pathogenesis": "此毒结于心胃，不升不降也",
          "organs": ["心", "胃"],
          "relations": [],
          "treatmentPrinciple": "治法消化其肉食，佐之以解毒之品",
          "formulaIds": ["bianzheng-formula-bianzheng-0363-4"],
          "keySentence": "然此方乃下逐之神方，倘可上涌，不必用此"
        },
        {
          "caseIndex": 3,
          "symptomText": "人有一时短见，服盐卤之毒，必至口咸作渴，腹中疼痛，身蜷脚缩而死",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "夫盐能补肾，何便杀人？", "rebuttal": "不知盐卤味苦，苦先入心" }
          ],
          "pathogenesis": "心肾之气不交，而盐卤流入于肠，而不可救矣",
          "organs": ["心", "肾", "大肠", "小肠"],
          "relations": [],
          "treatmentPrinciple": "治法必用甘以解之",
          "formulaIds": ["bianzheng-formula-bianzheng-0363-5"]
        },
        {
          "caseIndex": 4,
          "symptomText": "人有恣饮烧酒，大醉而死，其身体必腐烂臭秽",
          "disputes": [
            { "kind": "mistreatment", "claim": "倘止泻其火而解其毒", "rebuttal": "火泻毒解而气脱矣" }
          ],
          "pathogenesis": "多饮过度，力不能胜，一时醉倒，热性发作，腐肠烂胃",
          "organs": ["胃"],
          "relations": [],
          "treatmentPrinciple": "必须用井水频扑其心胸",
          "formulaIds": [],
          "formulaText": "后用解炎化酒汤救之"
        },
        {
          "caseIndex": 5,
          "symptomText": "人有爱食河，以致血毒中人，舌麻心闷，重者腹胀而气难舒，口开而声不出",
          "disputes": [
            { "kind": "commonPractice", "claim": "古人有拼死食河之语", "rebuttal": "其实河纯不能杀人，但与性怒者不甚相宜耳" }
          ],
          "pathogenesis": "大约肝经血燥，而胃气又弱者，多能中毒",
          "organs": ["肝", "胃"],
          "relations": [],
          "treatmentPrinciple": "治法吐出其肉，则气舒腹宽",
          "formulaIds": ["bianzheng-formula-bianzheng-0363-6"]
        }
      ]
    },
    {
      "clauseId": "bianzheng-0364",
      "contentHash": "f2dc4715ca564cc4",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有肠中自鸣，终日不已，嗳气吞酸，无有休歇",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为脾气之虚也", "rebuttal": "谁知是肝气之旺乎" }
          ],
          "pathogenesis": "惟肝木克脾土，则土气不能伸，而肠乃鸣矣",
          "organs": ["肝", "脾"],
          "relations": [{ "from": "肝", "to": "脾", "kind": "克" }],
          "treatmentPrinciple": "故治肠鸣之病，不必治肠，治脾土而已。亦不必专治脾土，治肝木而已",
          "formulaIds": ["bianzheng-formula-bianzheng-0364-1", "bianzheng-formula-bianzheng-0364-2"],
          "keySentence": "此方脾肝同治之法。肝平而脾气得养矣，脾安而肠气得通矣"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有饥饿之后，腹中肠鸣，手按之鸣少止者",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为大肠之虚也", "rebuttal": "谁知胃气之虚乎" }
          ],
          "pathogenesis": "今胃气既虚，仅可自顾，安能分布于大肠",
          "organs": ["胃", "大肠"],
          "relations": [],
          "treatmentPrinciple": "治法必须助胃气之弱",
          "formulaIds": ["bianzheng-formula-bianzheng-0364-3"],
          "keySentence": "此方大补胃中之气，绝不去实大肠，治胃而肠鸣自止"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有肠中作水声者，如囊裹浆状",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "亦肠鸣之病也", "rebuttal": "谁知是水蓄于大肠乎" },
            { "kind": "misdiagnosis", "claim": "水入大肠，必随糟粕而出，何以但作水声，不随糟粕而即出耶？", "rebuttal": "盖大肠之下为直肠，直肠之下为魄门，乃肺操其政，非肾操其政也" }
          ],
          "pathogenesis": "大肠寒而水乃注于中而不化，故作水声也",
          "organs": ["大肠", "肾", "肺", "命门", "膀胱"],
          "relations": [],
          "treatmentPrinciple": "治法补命门之火，兼利其水，则水从膀胱而化矣",
          "formulaIds": ["bianzheng-formula-bianzheng-0364-4"],
          "keySentence": "我多加肉桂，则肾气温和，直走膀胱，水有出路，岂尚流入大肠哉"
        }
      ]
    },
    {
      "clauseId": "bianzheng-0365",
      "contentHash": "a1380520025331df",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有无端大笑不止，或背人处自笑，异于平素者",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为心家有邪热也", "rebuttal": "谁知心包之火盛乎" },
            { "kind": "misdiagnosis", "claim": "其状绝似有祟凭之", "rebuttal": "孰知绝非祟也" }
          ],
          "pathogenesis": "膻中火盛，发而自笑",
          "organs": ["心包", "心"],
          "relations": [],
          "treatmentPrinciple": "治法惟泻心包之火，笑自止矣",
          "formulaIds": ["bianzheng-formula-bianzheng-0365-1"],
          "keySentence": "此方泻心包之火，仍是安心君之药"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有笑哭不常，忽而自哭，忽而自笑",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为鬼祟也", "rebuttal": "谁知积痰类祟乎" }
          ],
          "pathogenesis": "盖心气虚而不能生胃，而胃气亦虚矣",
          "organs": ["心", "胃"],
          "relations": [{ "from": "心", "to": "胃", "kind": "生" }],
          "treatmentPrinciple": "治法以化痰之药动其吐，痰出而哭与笑皆愈矣",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0366",
      "contentHash": "3975b27d6b5338f2",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": ["心", "胃"],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0366-1"],
          "keySentence": "惟用二陈汤为吐药，则新旧之病一治而永愈也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有无故自悲，涕泣不止",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为魅凭之也", "rebuttal": "谁知为脏燥之故乎" }
          ],
          "pathogenesis": "肺经虚则肺气干燥，无所滋润，衰伤欲哭之象生",
          "organs": ["肺", "脾"],
          "relations": [{ "from": "脾", "to": "肺", "kind": "生" }],
          "treatmentPrinciple": "必须补其肺金之母，土旺而金自旺矣",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0367",
      "contentHash": "8ca40529a230c881",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [
            { "kind": "drugDoubt", "claim": "惟肺燥善悲，不润肺解燥，反助土生火，不益增其燥乎？", "rebuttal": "不知助土生火，正助金以生气也，气旺而肺之燥自解" }
          ],
          "organs": ["脾", "肺"],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0367-1"]
        }
      ]
    },
    {
      "clauseId": "bianzheng-0368",
      "contentHash": "8a7ece50b3b5b549",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有少逢拂意之事，便觉怒气填胸，不能自遣，嗔恼不已",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为肝气之逆也", "rebuttal": "谁知肝血之少乎" }
          ],
          "pathogenesis": "盖血少则肝燥，肝燥则气逆也",
          "organs": ["肝"],
          "relations": [],
          "treatmentPrinciple": "故同一气恼之症，须分虚实以治之",
          "formulaIds": ["bianzheng-formula-bianzheng-0368-1"],
          "keySentence": "此方全是平肝之药，非泻肝之品也。肝得补而血生，郁得血而易散"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有晨夕之间，时多怒气，不必有可怒之事而心烦意躁，不能自遣，至夜则口干舌燥，止有一更睡熟，余则终夜常醒",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为肝血之少也", "rebuttal": "谁知是肾水之匮涸乎" }
          ],
          "pathogenesis": "肝子不足，由于肾母之不足也",
          "organs": ["肝", "肾", "心"],
          "relations": [{ "from": "肾", "to": "肝", "kind": "生" }],
          "treatmentPrinciple": "治法必须大滋肾水",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0369",
      "contentHash": "e41ddd8171408ad7",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": ["肾", "肝", "心"],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0369-1"],
          "keySentence": "是方补肾者六，补肝者四也。绝不去治心，而心气自交于肾者"
        }
      ]
    },
    {
      "clauseId": "bianzheng-0370",
      "contentHash": "8b87d7f9ad680cb9",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有口渴之极，快饮凉水，忽然喑哑，不能出声",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为心火亢热也", "rebuttal": "谁知肺气之闭乎" },
            { "kind": "misdiagnosis", "claim": "何得水而反闭耶？", "rebuttal": "不知水来克火，则火必为水所克" }
          ],
          "pathogenesis": "此种喑哑，乃水抑肺气而不升，非肺气之自败",
          "organs": ["肺", "心"],
          "relations": [{ "from": "心", "to": "肺", "kind": "克" }],
          "treatmentPrinciple": "治法宣扬肺气，分消其水湿",
          "formulaIds": ["bianzheng-formula-bianzheng-0370-1"],
          "keySentence": "此方宣通肺气，则肺气自扬。分消水势则火气自降"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有劳损弱怯，喘嗽不宁，渐渐喑哑，气息低沉",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为肺气之绝也", "rebuttal": "谁知是肾水之涸乎" },
            { "kind": "commonPractice", "claim": "世医谓金破必须补土", "rebuttal": "然而脾胃虽能生金，而补土之药多属阳药，用阳药以补土，则阳旺而阴愈消，反有损于肺矣" }
          ],
          "pathogenesis": "肾又不足，日来取资于肺，则子贫而母益贫矣",
          "organs": ["肺", "肾"],
          "relations": [{ "from": "肺", "to": "肾", "kind": "生" }],
          "treatmentPrinciple": "治法必须大补肾子之水，子富而母自不贫",
          "formulaIds": ["bianzheng-formula-bianzheng-0370-2"],
          "keySentence": "此方补肾之中，意仍注于补肺，然补肺之中，仍是补肾"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有口渴之甚，舌上无津，两唇开裂，喉中干燥，遂至失音",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为肺火之旺也", "rebuttal": "谁知心火太旺乎" },
            { "kind": "mistreatment", "claim": "倘不补水而徒泻其火", "rebuttal": "则火无水制，服寒凉之药反增其助火之焰" }
          ],
          "pathogenesis": "盖心之所以有余者，实因肾水之不足耳",
          "organs": ["心", "肺", "肾"],
          "relations": [{ "from": "心", "to": "肺", "kind": "克" }],
          "treatmentPrinciple": "治法必须泻心火之有余，滋肺金之不足",
          "formulaIds": ["bianzheng-formula-bianzheng-0370-3"]
        }
      ]
    },
    {
      "clauseId": "bianzheng-0371",
      "contentHash": "b013c3ff1ad17300",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "其症必头痛眩晕，胸膈膨胀，口吐黄痰，鼻流浊水",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为天灾流行", "rebuttal": "谁知皆人事召之也" },
            { "kind": "mistreatment", "claim": "不先用表散之味，遽用寒凉", "rebuttal": "火转闭塞而不得达，适所以害之也" }
          ],
          "pathogenesis": "然皆火热之毒不宣，郁而成之耳",
          "organs": ["肺", "胃"],
          "relations": [],
          "treatmentPrinciple": "故必须于散中用泻，则疫去如扫耳",
          "formulaIds": ["bianzheng-formula-bianzheng-0371-1", "bianzheng-formula-bianzheng-0371-2"]
        },
        {
          "caseIndex": 1,
          "symptomText": "偶传瘟疫，眼角忽然大肿，身子骤发寒热，喉咙大胀作痛",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "即用七星汤治之"
        }
      ]
    },
    {
      "clauseId": "bianzheng-0372",
      "contentHash": "1383968ec4734d2b",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "男子有交感之时，妇人正在兴浓，而男子先痿，阳事不坚，精难射远",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为命门之火衰也", "rebuttal": "谁知阳气之大虚乎?" }
          ],
          "pathogenesis": "此气也乃五脏之真气，非止命门之火也",
          "organs": ["脾", "肾", "命门"],
          "relations": [],
          "treatmentPrinciple": "但补其脾肾之气，若心、若肝、若肺之气自旺",
          "formulaIds": ["bianzheng-formula-bianzheng-0372-1"],
          "keySentence": "此方补气，绝不补阴，以病成于阳衰，则阴气必旺"
        },
        {
          "caseIndex": 1,
          "symptomText": "男子有泄精之时，止有一、二点之精",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为肾水之亏", "rebuttal": "谁知是天分之薄乎?" }
          ],
          "pathogenesis": "盖精少者，虽属之于天，未必不成之于人也",
          "organs": [],
          "relations": [],
          "formulaIds": ["bianzheng-formula-bianzheng-0372-2"]
        },
        {
          "caseIndex": 2,
          "symptomText": "男子有精力甚健，入房甚久，泄精之时，如热汤浇入子宫，妇人受之，必然吃惊，反不生育者",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "人以为久战之故，使妇女兴阑，以致子宫谨闭，精不得入", "rebuttal": "孰知不然" },
            { "kind": "mistreatment", "claim": "似宜泻火之有余矣", "rebuttal": "而火不可泻，泻火必致伤胃，反无生气" }
          ],
          "pathogenesis": "乃精热之自难存养也",
          "organs": ["肾", "胃"],
          "relations": [],
          "treatmentPrinciple": "治法但补其肾中之水，使水旺而火自平",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0373",
      "contentHash": "2437095cc5c49238",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
