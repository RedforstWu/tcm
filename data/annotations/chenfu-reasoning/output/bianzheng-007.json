{
  "entries": [
    {
      "clauseId": "bianzheng-0181",
      "contentHash": "abb937b213295607",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0181-1"
          ],
          "formulaText": "方用心肾两资汤",
          "keySentence": "此方心肾同治，补火而水足以相济，补水而火足以相生"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有咳嗽，吐痰不已，皮肤不泽，少动则喘",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "议者谓燥症必须补肾，肾水干枯而燥症乃成",
              "rebuttal": "然而此燥非因肾之干枯而来，因夏伤于热以耗损肺金之气"
            }
          ],
          "pathogenesis": "因夏伤于热以耗损肺金之气",
          "organs": [
            "肺",
            "脾",
            "肾"
          ],
          "relations": [
            {
              "from": "脾",
              "to": "肺",
              "kind": "生"
            },
            {
              "from": "肺",
              "to": "肾",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "不必去补肾水，但润脾而肺之燥可解",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0182",
      "contentHash": "5cb47b93e216f410",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [
            {
              "kind": "drugDoubt",
              "claim": "方名子母两濡，似乎止言脾肾也",
              "rebuttal": "然而治脾治肾，无非治肺也"
            }
          ],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0182-1",
            "bianzheng-formula-bianzheng-0182-2"
          ],
          "formulaText": "方用子母两濡汤",
          "keySentence": "此方肺、脾、肾同治之方也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有两胁胀满，皮肤如虫之咬，干呕而不吐酸",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为肝气之逆",
              "rebuttal": "谁知是肝气之燥乎"
            },
            {
              "kind": "drugDoubt",
              "claim": "或谓肝燥而用白芍、熟地濡润之药，自宜建功，乃用白术、茯苓、柴胡、神曲之类，不以燥益燥乎",
              "rebuttal": "不知过于濡润反不能受濡润之益，以脾喜燥也"
            }
          ],
          "pathogenesis": "肝中无血，则肝燥而气郁",
          "organs": [
            "肝",
            "脾",
            "胃",
            "肾",
            "肺"
          ],
          "relations": [
            {
              "from": "肝",
              "to": "脾",
              "kind": "克"
            },
            {
              "from": "肝",
              "to": "胃",
              "kind": "克"
            }
          ],
          "treatmentPrinciple": "必大滋乎肾，肾濡而肝亦濡也",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0182-3"
          ],
          "keySentence": "用燥于湿之中，正善于治燥耳"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有口渴善饮，时发烦躁，喜静而不喜动，见水果则快，遇热汤则憎",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为胃火之盛也",
              "rebuttal": "谁知是胃气之燥乎"
            }
          ],
          "pathogenesis": "胃中无水断难化物，水衰而物难化",
          "organs": [
            "胃"
          ],
          "relations": [],
          "treatmentPrinciple": "治法解燥须清热也",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0183",
      "contentHash": "0e688ab8d014a61e",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0183-1"
          ],
          "formulaText": "方用清解汤",
          "keySentence": "此方平阳明胃火者居其半，平少阴相火者居其半"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有肌肉消瘦，四肢如削，皮肤飞屑，口渴饮水",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为风消之症",
              "rebuttal": "谁知是脾燥之病乎"
            },
            {
              "kind": "misdiagnosis",
              "claim": "夫脾为湿土，本喜燥也，何反成风消之症乎",
              "rebuttal": "脾最惧者肝木也，木能克土"
            },
            {
              "kind": "drugDoubt",
              "claim": "此方润肺而不润脾，何脾消之症能愈",
              "rebuttal": "以症成于肺，故润肺而脾亦润也"
            }
          ],
          "pathogenesis": "盖脾燥由于肺燥，而肺燥由于胃燥也",
          "organs": [
            "脾",
            "肺",
            "胃",
            "肝"
          ],
          "relations": [
            {
              "from": "胃",
              "to": "脾",
              "kind": "移邪"
            },
            {
              "from": "肝",
              "to": "脾",
              "kind": "克"
            }
          ],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0183-2"
          ],
          "keySentence": "柴胡最抒肝气，肝抒则肝不克脾，脾气得养"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有目痛之后，眼角刺触，羞明喜暗",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "目无血而燥，宜是肝之病而非胆之病",
              "rebuttal": "然而肝胆为表里，肝燥而胆亦燥矣"
            }
          ],
          "pathogenesis": "血少则汁少，汁少即不能养胆养目矣",
          "organs": [
            "胆",
            "肝"
          ],
          "relations": [],
          "treatmentPrinciple": "亟宜滋胆中之汁，尤不可止治其胆，更宜润肝中之血，而胆之汁自润，目之火自解矣",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0184",
      "contentHash": "4a86131c9e031fcc",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0184-1"
          ],
          "formulaText": "方用四物汤加味治之",
          "keySentence": "四物汤补血，补肝中之血也，补肝而胆在其中矣"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有双目不痛，瞳神日加紧小，口干舌苦",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为心火之旺也",
              "rebuttal": "谁知是心包之干燥乎"
            }
          ],
          "pathogenesis": "然则瞳神之紧小，皆心包之无水，由于肾水之干枯也",
          "organs": [
            "心包",
            "心",
            "肾"
          ],
          "relations": [],
          "treatmentPrinciple": "补肾以滋心包",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0185",
      "contentHash": "d5a66360c55c235c",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0185-1"
          ],
          "formulaText": "方用救瞳汤",
          "keySentence": "此方乃肝肾同治之法也，心包无水，不治心包而滋肝肾者，以肝乃心包之母也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有秋后闭结不能大便",
          "disputes": [
            {
              "kind": "mistreatment",
              "claim": "切戒用大黄、芒硝以开结也",
              "rebuttal": "盖此病本伤阴之症，又加劫阴之药，重伤其阴，必成为阳结之症"
            }
          ],
          "pathogenesis": "盖肺与大肠相为表里，肺燥而大肠不能独润",
          "organs": [
            "肺",
            "大肠",
            "肾"
          ],
          "relations": [
            {
              "from": "肺",
              "to": "肾",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "治法惟补肺肾，而大肠自润矣",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0185-2"
          ],
          "keySentence": "何若大补其肺肾之阴，使阴足而阳自化之为得耶"
        },
        {
          "caseIndex": 2,
          "symptomText": "人有夏秋之间，小便不通，点滴不出",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为膀胱之热结",
              "rebuttal": "谁知是肺燥而膀胱亦燥乎"
            }
          ],
          "pathogenesis": "此小便之不通，实无水之可化也",
          "organs": [
            "膀胱",
            "肾",
            "肺"
          ],
          "relations": [],
          "treatmentPrinciple": "治法不可徒润膀胱，而亟当润肺；尤不可徒润夫肺，尤当大补夫肾",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0186",
      "contentHash": "16385322764a0712",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0186-1"
          ],
          "formulaText": "方用启结生阴汤",
          "keySentence": "此方补肾而仍补肺者，滋其生水之源也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有消渴饮水，时而渴甚，时而渴轻",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为心肾二火之沸腾",
              "rebuttal": "谁知是三焦之气燥乎"
            }
          ],
          "pathogenesis": "火动必烁干三焦之气，则三焦更燥",
          "organs": [
            "三焦",
            "肾"
          ],
          "relations": [],
          "treatmentPrinciple": "欲解三焦之渴，舍补肾水何法哉",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0187",
      "contentHash": "adaa61ff3eafa9c9",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0187-1"
          ],
          "formulaText": "方用六味地黄汤加味治之",
          "keySentence": "六味治肾，更加麦冬、五味以治肺者，非止清肺金之火也"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有大病之后，小肠细小不能出溺，胀甚欲死",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为小肠之火",
              "rebuttal": "谁知是小肠之干燥哉"
            }
          ],
          "pathogenesis": "盖肾水竭而膀胱枯，故小肠亦燥而成结耳",
          "organs": [
            "小肠",
            "膀胱",
            "肾",
            "肺"
          ],
          "relations": [],
          "treatmentPrinciple": "治法必须大补肾中之水，而补水又必补肺金之气",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0188",
      "contentHash": "58858d8282d3f8c1",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0188-1"
          ],
          "formulaText": "方用治本消水汤",
          "keySentence": "此方不治小肠，专治肺肾，肺肾不燥，小肠之燥自润矣"
        }
      ]
    },
    {
      "clauseId": "bianzheng-0189",
      "contentHash": "32bdc1a4818a615f",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "人有胃火熏蒸，日冲肺金，遂至痿弱不能起立，欲嗽不能，欲咳不敢，及至咳嗽又连声不止，肺中大痛",
          "disputes": [
            {
              "kind": "mistreatment",
              "claim": "人见其痿弱不能起立，或用治痿之药",
              "rebuttal": "愈伤肺气，奚能起痿"
            }
          ],
          "pathogenesis": "由于阳明之火上冲于肺，而肺经津液衰少，不能灭阳明之焰",
          "organs": [
            "胃",
            "肺",
            "肾"
          ],
          "relations": [
            {
              "from": "肺",
              "to": "肾",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "治法宜泻其胃中之火，大补其肺经之气，然又不可徒补其肺中之气，更宜兼补其肾中之水",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0189-1"
          ],
          "keySentence": "胃火之盛，胃土之衰也，扶其土，即所以泻其火"
        },
        {
          "caseIndex": 1,
          "symptomText": "胃火上冲于心，心中烦闷，怔忡惊悸，久则成痿，两足无力，不能动履",
          "disputes": [
            {
              "kind": "mistreatment",
              "claim": "倘徒泻心火",
              "rebuttal": "则胃子见心母之寒，益肆其炎氛，愈添心中之燥"
            }
          ],
          "pathogenesis": "胃火熏心，则心火大燥，此害生于恩也",
          "organs": [
            "胃",
            "心",
            "肾"
          ],
          "relations": [
            {
              "from": "心",
              "to": "胃",
              "kind": "生"
            }
          ],
          "treatmentPrinciple": "治法宜大益其肾中之水，少清其胃中之火",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0190",
      "contentHash": "2a10f28da0792cca",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0190-1",
            "bianzheng-formula-bianzheng-0190-2"
          ],
          "formulaText": "方用清胃生髓丹",
          "keySentence": "故不若用玄参、甘菊之类，既清其胃火，而又不损其胃土"
        },
        {
          "caseIndex": 1,
          "symptomText": "善用肥甘之物，食后即饥，少不饮食，便觉头红面热，两足乏力，不能行走",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为阳明胃火之旺，以致成痿",
              "rebuttal": "谁知是太阴脾火之盛，以烁干其阴乎"
            },
            {
              "kind": "drugDoubt",
              "claim": "火盛易消，以至善饥，似宜用消导之剂，以损脾胃之气",
              "rebuttal": "不知脾胃之土，俱不可伤，伤土而火愈旺矣"
            }
          ],
          "pathogenesis": "盖太阴与阳明为表里，阳明火旺，而太阴之火亦旺矣",
          "organs": [
            "脾",
            "胃",
            "肾"
          ],
          "relations": [],
          "treatmentPrinciple": "治法益太阴之阴水，以胜其阳明之阳火",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0190-3"
          ],
          "keySentence": "此方补脾胃之土，即所以补其火也"
        },
        {
          "caseIndex": 2,
          "symptomText": "大怒之后，两胁胀满，胸间两旁时常作痛，遂至饭食不思，口渴索饮，久则两腿酸痛",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为痰火之作祟也",
              "rebuttal": "谁知是肝经之痿症乎"
            }
          ],
          "pathogenesis": "夫肝经之痿，阳明之火助之也",
          "organs": [
            "肝",
            "脾",
            "胃",
            "肾"
          ],
          "relations": [
            {
              "from": "肝",
              "to": "脾",
              "kind": "克"
            },
            {
              "from": "肝",
              "to": "胃",
              "kind": "克"
            }
          ],
          "treatmentPrinciple": "治法必须平肝，而并泻阳明之火",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0191",
      "contentHash": "be619f42198d1008",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0191-1",
            "bianzheng-formula-bianzheng-0191-2"
          ],
          "formulaText": "方用伐木汤",
          "keySentence": "此方泻肝火以平肝气，然而阳明胃火，未尝不同治之"
        },
        {
          "caseIndex": 1,
          "symptomText": "遂至两足痿弱，立则腿颤，行则膝痛，卧床不起，然颇能健饭易消",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为食消之症也",
              "rebuttal": "谁知是肾火之盛，引动胃火以成肾痿乎"
            }
          ],
          "pathogenesis": "盖胃为肾之关，胃之开阖肾司之也",
          "organs": [
            "肾",
            "胃"
          ],
          "relations": [],
          "treatmentPrinciple": "治法急宜大补肾水以制阳光",
          "formulaIds": [
            "bianzheng-formula-bianzheng-0191-3"
          ],
          "keySentence": "此方大补肾阴，全不去泻胃中之火"
        },
        {
          "caseIndex": 2,
          "symptomText": "烦躁口渴，面红而热，时索饮食，饮后仍渴，食后仍饥，两足乏力，不能起立，吐痰甚多",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为阳明之实火也",
              "rebuttal": "谁知是阳明之虚火乎"
            }
          ],
          "pathogenesis": "虚火不清，则销铄骨髓，有亡阴之祸",
          "organs": [
            "胃",
            "肾"
          ],
          "relations": [],
          "treatmentPrinciple": "必须清胃火而加之生津、生液之味",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "bianzheng-0192",
      "contentHash": "15c05e59f619febe",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [
            "bianzheng-formula-bianzheng-0192-1"
          ],
          "formulaText": "方用散余汤",
          "keySentence": "此方散胃火之余氛，不去损胃土之生气"
        },
        {
          "caseIndex": 1,
          "symptomText": "人有好酒，久坐腰痛，渐次痛及右腹，又及右脚，又延及右手，不能行动，已而齿痛",
          "disputes": [
            {
              "kind": "misdiagnosis",
              "claim": "人以为贼风之侵体也",
              "rebuttal": "谁知是痿症乎"
            },
            {
              "kind": "misdiagnosis",
              "claim": "痿不宜痛，今腹、脚、手、齿俱痛，恐非痿也",
              "rebuttal": "痿病兼热多者，必筋急而痛，是痿症未尝无痛也"
            }
          ],
          "pathogenesis": "诸痿皆起于肺热，人善饮，则肺必热矣",
          "organs": [
            "肺",
            "胃"
