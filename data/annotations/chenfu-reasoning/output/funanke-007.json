    {
      "clauseId": "funanke-0185",
      "contentHash": "c016d73d6c3dd7c9",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "如大便结、脉沉实者",
          "disputes": [
            { "kind": "commonPractice", "claim": "除清凉发散正治外，人即束手无策", "rebuttal": "而不知更有三法" }
          ],
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "名釜底抽薪之法",
          "formulaIds": [],
          "formulaText": "用酒蒸大黄三钱微下之"
        },
        {
          "caseIndex": 1,
          "symptomText": "如大便泻，脉沉足冷者",
          "disputes": [],
          "pathogenesis": "是冷极于下，而迫其火之上升也",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "此名导龙入海之法",
          "formulaIds": [],
          "formulaText": "宜六味地黄汤，加牛膝、车前、肉桂"
        },
        {
          "caseIndex": 2,
          "symptomText": "大便如常，脉无力者",
          "disputes": [],
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "此名引火归源之法也",
          "formulaIds": [],
          "formulaText": "用牛膝车前引下之"
        }
      ]
    },
    {
      "clauseId": "funanke-0186",
      "contentHash": "e8655f04d566f8e8",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "如足痛足肿，无力虚软，膝疮红肿",
          "disputes": [],
          "pathogenesis": "不效者定是中气下陷，湿热下流",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "用补中益气升提之"
        },
        {
          "caseIndex": 1,
          "symptomText": "如足软不能行而能食，名曰痿症",
          "disputes": [],
          "organs": ["肺"],
          "relations": [],
          "treatmentPrinciple": "宜清肺热",
          "formulaIds": []
        },
        {
          "caseIndex": 2,
          "symptomText": "如治泄泻",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "亦用补中益气，去当归，加炮姜苍术"
        },
        {
          "caseIndex": 3,
          "symptomText": "如尿血",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜清心莲子饮"
        },
        {
          "caseIndex": 4,
          "symptomText": "如右关微，或数大无力",
          "disputes": [],
          "pathogenesis": "是脾虚不摄血",
          "organs": ["脾"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜六君子加炮姜"
        },
        {
          "caseIndex": 5,
          "symptomText": "若右关沉紧",
          "disputes": [],
          "pathogenesis": "是饮食伤脾，不能摄血",
          "organs": ["脾"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "加沉香贰分"
        },
        {
          "caseIndex": 6,
          "symptomText": "右寸洪数",
          "disputes": [],
          "pathogenesis": "是实热在肺",
          "organs": ["肺"],
          "relations": [],
          "treatmentPrinciple": "宜清肺",
          "formulaIds": [],
          "formulaText": "麦冬、花粉、元参、枯芩、桔梗、五味子、枳壳"
        }
      ]
    },
