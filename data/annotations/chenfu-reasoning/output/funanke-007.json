            { "kind": "commonPractice", "claim": "世人动曰惊风", "rebuttal": "谁知小儿惊则有之，而风则无" },
            { "kind": "mistreatment", "claim": "内风作外风治", "rebuttal": "是速之死也" }
          ],
          "pathogenesis": "盖小儿阳旺内热，内热则生风，是非外来之风，乃内出之风也",
          "organs": ["肝", "脾"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0206-1"],
          "keySentence": "此方健脾平肝之圣药,肝平则火散，脾健则风止"
        }
      ]
    },
