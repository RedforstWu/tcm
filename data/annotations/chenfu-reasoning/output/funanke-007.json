      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "小儿不食乳",
          "disputes": [],
          "pathogenesis": "心热也",
          "organs": ["心"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "不若用黄连三分,煎汤一分，灌数次即食矣"
        }
      ]
    },
    {
      "clauseId": "funanke-0202",
      "contentHash": "ca92cac630fe01b5",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "车前子炒焦为细末，敷之即干"
        }
      ]
    },
    {
      "clauseId": "funanke-0203",
      "contentHash": "1b80b4bf40d37352",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "山根之上，有青筋直视者",
          "disputes": [],
          "pathogenesis": "乃肝热也",
          "organs": ["肝"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0203-1"]
        },
        {
          "caseIndex": 1,
          "symptomText": "有青筋横现者",
          "disputes": [],
          "pathogenesis": "亦肝热也",
          "organs": ["肝"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0203-1"],
          "formulaText": "用前方加柴胡（ 伍分） 麦芽（ 壹钱） 干姜（ 壹分）"
        },
        {
          "caseIndex": 2,
          "symptomText": "有红筋直现者",
          "disputes": [],
          "pathogenesis": "心热也",
          "organs": ["心"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0203-1"],
          "formulaText": "亦用前方加黄连（ 壹分） 麦冬（ 伍分）去半夏，加桑白皮、天花粉（ 各贰分）"
        },
        {
          "caseIndex": 3,
          "symptomText": "有红筋斜现者",
          "disputes": [
            { "kind": "drugDoubt", "claim": "不可用半夏", "rebuttal": "用桑白皮、花粉可也" }
          ],
          "pathogenesis": "亦心热也",
          "organs": ["心"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0203-1"],
          "formulaText": "亦用前方加黄连（ 贰分）"
        },
        {
          "caseIndex": 4,
          "symptomText": "有黄筋现于山根者，不论横直，总是脾胃之症,或吐或泻，腹痛或不思食",
          "disputes": [],
          "pathogenesis": "总是脾胃之症",
          "organs": ["脾", "胃"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0203-2"]
        }
      ]
    },
