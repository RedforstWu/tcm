      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "左手脉大",
          "disputes": [],
          "pathogenesis": "血分之劳也",
          "organs": [],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0055-1"]
        }
      ]
    },
    {
      "clauseId": "funanke-0056",
      "contentHash": "ad2c9692c5cd8726",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "若过出汗",
          "disputes": [],
          "pathogenesis": "恐其亡阳",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "不可不用药以敛之",
          "formulaIds": ["funanke-formula-funanke-0056-1"]
        }
      ]
    },
    {
      "clauseId": "funanke-0057",
      "contentHash": "af17f7638cdc0a40",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "痨症既成",
          "disputes": [
            { "kind": "mistreatment", "claim": "若徒补其气血, 而不入杀虫之药", "rebuttal": "则饮食入胃，祇荫虫而不生气血" },
            { "kind": "mistreatment", "claim": "若但杀虫而不补气血", "rebuttal": "则五藏俱受伤，又何有生理哉" }
          ],
          "pathogenesis": "必有虫生之以食人之气血也",
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "惟于大补之中，加杀虫之药",
          "formulaIds": ["funanke-formula-funanke-0057-1"]
        }
      ]
    },
    {
      "clauseId": "funanke-0058",
      "contentHash": "a864703168af2caa",
      "cases": []
    },
    {
      "clauseId": "funanke-0059",
      "contentHash": "d9ac6c0a8a6816cc",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "伤风咳嗽吐痰是也",
          "disputes": [
            { "kind": "mistreatment", "claim": "若发散燥痰太过", "rebuttal": "则肺不敛必嗽愈甚，而上呛血丝, 久则肺伤而肾炽" },
            { "kind": "mistreatment", "claim": "若寒凉滋润太过", "rebuttal": "则肺不舒必痰愈多，而气喘声痿, 久则金冷而水寒" }
          ],
          "pathogenesis": "上焦之痰, 原在胃中而不在肺",
          "organs": ["胃", "肺"],
          "relations": [],
          "formulaIds": ["funanke-formula-funanke-0059-1"],
          "keySentence": "去其胃中之痰，而肺自然清肃"
        }
      ]
    },
    {
      "clauseId": "funanke-0060",
      "contentHash": "722fbc035e549b7f",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "必观其色之白与黄而辨之",
          "disputes": [],
          "pathogenesis": "黄者火已退也，白者火正炽也",
          "organs": ["脾"],
          "relations": [],
          "treatmentPrinciple": "正炽者用寒凉之品, 将退者用袪逐之味，今一方而俱治之",
          "formulaIds": ["funanke-formula-funanke-0060-1"],
          "keySentence": "此方健脾去湿，治痰之在中焦者也"
        }
      ]
    }
