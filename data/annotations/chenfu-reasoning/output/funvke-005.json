      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "治产妇呕逆不食",
          "disputes": [],
          "pathogenesis": "产后劳伤脏腑，寒邪易乘于肠胃，则气逆呕吐而不下食也",
          "organs": ["胃"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "◎加减生化汤：治产妇呕逆不食"
        },
        {
          "caseIndex": 1,
          "symptomText": "治产后七日外呕逆不食",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "◎温胃丁香散"
        },
        {
          "caseIndex": 2,
          "symptomText": "治广妇呕土心冲目弦",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "◎石莲散"
        },
        {
          "caseIndex": 3,
          "symptomText": "治产妇虚弱，口渴气少",
          "disputes": [],
          "pathogenesis": "由产后血少多汗内烦不生津液",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "◎生津益胃汤"
        }
      ]
    },
    {
      "clauseId": "funvke-0122",
      "contentHash": "66a1770f056113c5",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "外感风寒，咳嗽鼻塞，声重恶寒",
          "disputes": [
            { "kind": "mistreatment", "claim": "勿用麻黄以动汗", "rebuttal": "总之产后不可发汗" },
            { "kind": "mistreatment", "claim": "嗽而有声，痰少面赤，勿用凉药", "rebuttal": "必须调理半月后，方可用凉药，半月前不当用" },
            { "kind": "drugDoubt", "claim": "而第一与第二方中，均有知母", "rebuttal": "此必于既感之后，将蕴而为燥热，不得已而用之" }
          ],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "◎加味生化汤：治产后外感风寒咳嗽及鼻塞声重"
        },
        {
          "caseIndex": 1,
          "symptomText": "治产后虚弱，旬日内外感风寒，咳嗽声重有痰，或身热头痛及汗多者",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "◎加参安肺生化汤"
        },
        {
          "caseIndex": 2,
          "symptomText": "治半月后干嗽有声，痰少者",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "加味四物汤"
        }
      ]
    },
    {
      "clauseId": "funvke-0123",
      "contentHash": "b89476c8726f40a7",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "产后水气，手足浮肿，皮肤见光荣色",
          "disputes": [],
          "pathogenesis": "乃脾虚不能制水，肾虚不能行水也",
          "organs": ["脾", "肾"],
          "relations": [],
          "treatmentPrinciple": "必以大补气血为先，佐以苍术、白术、茯苓补脾",
          "formulaIds": [],
          "formulaText": "健脾利水，补中益气汤"
        },
        {
          "caseIndex": 1,
          "symptomText": "如因寒邪湿气伤脾，无汗而肿",
          "disputes": [],
          "organs": ["脾"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜姜皮、半夏，苏叶加于补气方，以表汗"
        },
        {
          "caseIndex": 2,
          "symptomText": "以致面目浮虚，四肢肿胀气喘",
          "disputes": [],
          "pathogenesis": "治产后风湿客伤脾经，气血凝滞",
          "organs": ["脾"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "◎五皮散"
        },
        {
          "caseIndex": 3,
          "symptomText": "产后恶露不净，停留胞络，致令浮肿",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "若以水气治之，投以甘遂等药", "rebuttal": "误矣" }
          ],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "但服调经散，则血行而肿消矣"
        }
      ]
    },
    {
      "clauseId": "funvke-0124",
      "contentHash": "1e87e7c3cd55aec8",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "产后恶露流于腰臂足关节之处，或漫肿、或结块，久则肿起作痛，肢体倦怠",
          "disputes": [],
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "急宜用葱熨法以治外肿；内服参归生化汤以消血滞",
          "formulaIds": [],
          "formulaText": "◎参归生化汤"
        },
        {
          "caseIndex": 1,
          "symptomText": "或未成脓，未溃",
          "disputes": [],
          "pathogenesis": "气血虚也",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服八珍汤"
        },
        {
          "caseIndex": 2,
          "symptomText": "憎寒恶寒",
          "disputes": [],
          "pathogenesis": "阳气虚也",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服十全大补汤"
        },
        {
          "caseIndex": 3,
          "symptomText": "补后大热",
          "disputes": [],
          "pathogenesis": "阴血虚也",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服四物汤，加参、术、丹皮"
        },
        {
          "caseIndex": 4,
          "symptomText": "呕逆",
          "disputes": [],
          "pathogenesis": "胃气虚也",
          "organs": ["胃"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服六君子汤，加炮姜、干姜"
        },
        {
          "caseIndex": 5,
          "symptomText": "食少体倦",
          "disputes": [],
          "pathogenesis": "脾气虚也",
          "organs": ["脾"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服补中益气汤"
        },
        {
          "caseIndex": 6,
          "symptomText": "四肢冷逆，小便频数",
          "disputes": [],
          "pathogenesis": "肾气虚也",
          "organs": ["肾"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "补中益气汤加益智仁一钱"
        },
        {
          "caseIndex": 7,
          "symptomText": "治产后流注恶露，日久成肿",
          "disputes": [
            { "kind": "mistreatment", "claim": "若未补气血旺", "rebuttal": "不可服此方" }
          ],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "神仙回洞散"
        }
      ]
    },
    {
      "clauseId": "funvke-0125",
      "contentHash": "64ac362957354ecd",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "其人素弱，临产又劳，中气不足，胸膈不利，而转运稽迟",
          "disputes": [
            { "kind": "mistreatment", "claim": "又因血虚大便燥结，误下", "rebuttal": "而愈胀" },
            { "kind": "commonPractice", "claim": "治者若但知伤食宜消，气郁宜散，恶露当攻，便结可下", "rebuttal": "则胃气反损，满闷益增，气不升降，湿热积久，遂成膨胀" }
          ],
          "pathogenesis": "殊不知气血两虚",
          "organs": ["脾", "胃"],
          "relations": [],
          "treatmentPrinciple": "当大补气血，以补中虚",
          "formulaIds": [],
          "formulaText": "若产后即服生化汤以消块止痛，又服加参生化汤以健脾胃"
        },
        {
          "caseIndex": 1,
          "symptomText": "如产后中风，气不足，微满，误服耗气药而胀者",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "服补中益气汤"
        },
        {
          "caseIndex": 2,
          "symptomText": "如伤食，误服消导药成胀；或胁下积块",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服健脾汤"
        },
        {
          "caseIndex": 3,
          "symptomText": "如大便不通，误服下药成胀，及腹中作痛",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服养荣生化汤"
        },
        {
          "caseIndex": 4,
          "symptomText": "凡误用消食耗气药，以致绝谷",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "长生活命丹屡效"
        }
      ]
    },
    {
      "clauseId": "funvke-0126",
      "contentHash": "adde8ec43ecde143",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "则心中跳动不安，谓之怔仲；若惕然震惊，心中怯怯，如人将捕之状，谓之惊悸",
          "disputes": [],
          "pathogenesis": "由产忧惊劳倦，去血过多",
          "organs": ["心", "脾", "胃"],
          "relations": [],
          "treatmentPrinciple": "惟调和脾胃，志定神清而病愈矣",
          "formulaIds": [],
          "formulaText": "宜服生化汤，且补血行块"
        },
        {
          "caseIndex": 1,
          "symptomText": "如块消痛止后患此",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服加减养荣汤"
        },
        {
          "caseIndex": 2,
          "symptomText": "治产后心血不定，心神不安",
          "disputes": [],
          "organs": ["心"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "◎养心汤"
        }
      ]
    },
    {
      "clauseId": "funvke-0127",
      "contentHash": "b7144df8ff670f0b",
      "cases": [
        {
          "caseIndex": 0,
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服保真汤。先服清骨散"
        },
        {
          "caseIndex": 1,
          "symptomText": "治骨蒸劳热。若服清骨散、梅连丸不效服此方",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "◎加味大造汤"
        }
      ]
    },
    {
      "clauseId": "funvke-0128",
      "contentHash": "47ccd712515e823b",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "因胃脘在心之下，劳伤风寒，及食冷物而作痛",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "俗呼为心痛", "rebuttal": "此即胃脘痛" }
          ],
          "pathogenesis": "劳伤风寒，及食冷物而作痛",
          "organs": ["胃"],
          "relations": [],
          "treatmentPrinciple": "治当散胃中之寒气，消胃中之冷物",
          "formulaIds": [],
          "formulaText": "必用生化汤，佐消寒食之药"
        },
        {
          "caseIndex": 1,
          "symptomText": "若绵绵而痛，可按止之，问无血块",
          "disputes": [],
          "organs": [],
          "relations": [],
          "treatmentPrinciple": "则当论虚而加补也",
          "formulaIds": []
        }
      ]
    },
    {
      "clauseId": "funvke-0129",
      "contentHash": "931b80f5e813ef30",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "块痛",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "只服生化汤，调失笑散二钱，加元胡一钱"
        },
        {
          "caseIndex": 1,
          "symptomText": "无块",
          "disputes": [],
          "pathogenesis": "则是遇风冷作痛",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服加减生化汤"
        }
      ]
    },
    {
      "clauseId": "funvke-0130",
      "contentHash": "bbfb5aaf4d6d137b",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "产后虚中，感寒饮冷，其寒下攻小腹作痛；又有血块作痛者；又产后血虚脐下痛者",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "并治之以加减生化汤"
        },
        {
          "caseIndex": 1,
          "symptomText": "若无块，但小腹痛，亦可按而少止者",
          "disputes": [],
          "pathogenesis": "属血虚",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "加熟地三钱，前胡、肉桂各一钱为末，名前胡散"
        }
      ]
    },
    {
      "clauseId": "funvke-0131",
      "contentHash": "268c86912e59e605",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "指节冷痛，头汗不止",
          "disputes": [],
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "先将猪肾煮熟，取汁煎药八分，温服"
        }
      ]
    },
    {
      "clauseId": "funvke-0132",
      "contentHash": "cb89cdccaceaf8ce",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "故腰背不能转侧，手足不能动履，或身热头痛",
          "disputes": [
            { "kind": "misdiagnosis", "claim": "若误作伤寒，发表出汗", "rebuttal": "则筋脉动荡，手足发冷，变症出焉" }
          ],
          "pathogenesis": "气弱则经络间血多阻滞，累日不散，则筋牵脉引，骨节不利",
          "organs": [],
          "relations": [],
          "formulaIds": [],
          "formulaText": "宜服趁痛散"
        }
      ]
    },
    {
