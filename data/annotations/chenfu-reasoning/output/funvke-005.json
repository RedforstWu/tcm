      "contentHash": "58b1e71a04211576",
      "cases": [
        {
          "caseIndex": 0,
          "symptomText": "若乳房臃肿，结核色红，数日外肿痛溃稠脓",
          "disputes": [],
          "pathogenesis": "此属胆胃热毒，气血壅滞",
          "organs": ["胆", "胃", "肝"],
          "relations": [],
          "formulaIds": [],
          "formulaText": "◎瓜蒌散：治一切痈疽，并治乳痈"
        },
        {
          "caseIndex": 1,
          "symptomText": "若初起内结小核，不红不肿不痛，积之岁月，渐大如巉岩石，破如熟榴",
